	<!-- EXPORTED, not imported: this identifier is ours, in our own reverse-DNS namespace, and
	     nothing else on the system declares these extensions. That absence is the whole problem —
	     with no declaration anywhere, macOS types a `.vars`/`.env` file as a throwaway `dyn.…` and
	     REFUSES to bind any app to it (`duti -s` fails with -50), so the app could open the file
	     from its own panel while the Finder insisted nothing could. `.txt`/`.csv`/`.log` escape
	     that only because other apps already register them as public types. Extensions here must
	     mirror the tail of `DocumentTypes.plainTextExtensions`. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Configuration File</string>
			<key>UTTypeIdentifier</key>
			<string>ai.ww-w.fast-md-reader.config-text</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>conf</string>
					<string>cfg</string>
					<string>ini</string>
					<string>env</string>
					<string>vars</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
