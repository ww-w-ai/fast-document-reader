+/// 테두리/배경 정의 한 항목. 네 변은 HWP 의 `BorderFill.borders` 순서(좌·우·상·하)를 이름으로
+/// 풀어 담는다 — 배열 인덱스로 넘기면 소비자가 순서를 재발명하게 되고, 그 실수는 화면에서
+/// "엉뚱한 변에 선이 그어짐" 으로만 드러난다.
+#[derive(Serialize)]
+struct BorderFillDto {
+    left: BorderEdgeDto,
+    right: BorderEdgeDto,
+    top: BorderEdgeDto,
+    bottom: BorderEdgeDto,
+    /// 셀/표 배경의 단색(`"RRGGBB"`). 렌더러와 **같은 판정**(`resolve_single_border_style`)을
+    /// 거친 값이라, 패턴·그라데이션·이미지 채우기와 "채우기 없음"(투명)은 여기서 null 이 된다 —
+    /// 호스트는 단색만 칠하고 나머지는 칠하지 않는다. 두 번째 판정 로직을 두지 않는 이유는
+    /// 그것이 렌더러와 드리프트하기 때문.
+    #[serde(rename = "bg", skip_serializing_if = "Option::is_none")]
+    background: Option<String>,
+}
+
+/// 한 변의 선. `type` 이 `"none"` 이면 **문서가 그 변을 명시적으로 껐다**는 뜻이고, 그때는
+/// 폭·색을 싣지 않는다(의미가 없다). 소비자는 "선 없음" 과 "언급 없음" 을 구분해야 하는데,
+/// 이 테이블에 항목이 있다는 것 자체가 이미 "문서가 말했다" 이므로 `"none"` 은 억제이지 침묵이
+/// 아니다. 폭은 pt — HWP 는 16 단계 mm 열거값으로 저장하므로 여기서 pt 로 환산해 내보낸다
+/// (호스트가 mm 표를 다시 갖지 않게).
+#[derive(Serialize)]
+struct BorderEdgeDto {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    #[serde(rename = "widthPt", skip_serializing_if = "Option::is_none")]
+    width_pt: Option<f64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    color: Option<String>,
+}
+
+/// `BorderLineType` → JSON 문자열. HWP 스펙 표 27 의 이름을 그대로 쓴다.
+fn border_line_type_str(kind: BorderLineType) -> &'static str {
+    match kind {
+        BorderLineType::None => "none",
+        BorderLineType::Solid => "solid",
+        BorderLineType::Dash => "dash",
+        BorderLineType::Dot => "dot",
+        BorderLineType::DashDot => "dashDot",
+        BorderLineType::DashDotDot => "dashDotDot",
+        BorderLineType::LongDash => "longDash",
+        BorderLineType::Circle => "circle",
+        BorderLineType::Double => "double",
+        BorderLineType::ThinThickDouble => "thinThickDouble",
+        BorderLineType::ThickThinDouble => "thickThinDouble",
+        BorderLineType::ThinThickThinTriple => "thinThickThinTriple",
+        BorderLineType::Wave => "wave",
+        BorderLineType::DoubleWave => "doubleWave",
+        BorderLineType::Thick3D => "thick3d",
+        BorderLineType::Thick3DReverse => "thick3dReverse",
+        BorderLineType::Thin3D => "thin3d",
+        BorderLineType::Thin3DReverse => "thin3dReverse",
+    }
+}
+
+fn border_edge_dto(line: &BorderLine) -> BorderEdgeDto {
+    if line.line_type == BorderLineType::None {
+        return BorderEdgeDto {
+            kind: "none",
+            width_pt: None,
+            color: None,
+        };
+    }
+    // 굵기 index(0~15) → mm → pt. 파서·직렬화기가 공유하는 그 표 하나만 읽는다.
+    let mm = BORDER_WIDTHS
+        .get(line.width as usize)
+        .map(|(mm, _)| *mm)
+        .unwrap_or(BORDER_WIDTHS[0].0);
+    BorderEdgeDto {
+        kind: border_line_type_str(line.line_type),
+        width_pt: Some(mm * 72.0 / 25.4),
+        color: Some(color_hex(line.color)),
+    }
+}
+
+/// `doc_info.border_fills` 를 문서 수준 테이블로 만든다. 인덱스는 원본 순서 그대로 —
+/// 셀이 이미 들고 있는 `borderFillId - 1` 이 곧 행 번호가 되어 재매핑 테이블이 필요 없다.
+fn build_border_fills(doc_info: &DocInfo) -> Vec<BorderFillDto> {
+    doc_info
+        .border_fills
+        .iter()
+        .map(|bf| {
+            let resolved = resolve_single_border_style(bf);
+            BorderFillDto {
+                left: border_edge_dto(&bf.borders[0]),
+                right: border_edge_dto(&bf.borders[1]),
+                top: border_edge_dto(&bf.borders[2]),
+                bottom: border_edge_dto(&bf.borders[3]),
+                background: resolved.fill_color.map(color_hex),
+            }
+        })
+        .collect()
+}
