-fn should_suppress_group_child_construction_stroke(drawing: &DrawingObjAttr) -> bool {
+pub(crate) fn should_suppress_group_child_construction_stroke(drawing: &DrawingObjAttr) -> bool {
     if drawing.caption.is_some() {
