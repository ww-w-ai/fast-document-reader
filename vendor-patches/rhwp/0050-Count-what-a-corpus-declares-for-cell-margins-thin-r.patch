diff --git a/tests/fmd_thin_row_probe.rs b/tests/fmd_thin_row_probe.rs
new file mode 100644
index 000000000..10fe5495d
--- /dev/null
+++ b/tests/fmd_thin_row_probe.rs
@@ -0,0 +1,63 @@
+//! 문서가 「얇은 띠」로 선언한 표 행이 몇 개인가 — 우리가 글자 한 줄로 부풀리는 그 행들.
+use rhwp::model::control::Control;
+use rhwp::wasm_api::HwpDocument;
+use std::{collections::BTreeMap, fs, path::Path};
+
+fn walk<'a>(controls: &'a [Control], out: &mut Vec<&'a rhwp::model::table::Table>) {
+    for c in controls {
+        if let Control::Table(t) = c {
+            out.push(t);
+            for cell in &t.cells {
+                for p in &cell.paragraphs { walk(&p.controls, out); }
+            }
+        }
+    }
+}
+
+#[test]
+fn probe_thin_rows() {
+    let Ok(path) = std::env::var("FMD_THIN_DOC") else { return };
+    let bytes = fs::read(Path::new(&path)).expect("read");
+    let doc = HwpDocument::from_bytes(&bytes).expect("parse");
+    let mut tables = Vec::new();
+    for s in &doc.document().sections {
+        for p in &s.paragraphs { walk(&p.controls, &mut tables); }
+    }
+    // 행 높이 = 그 행 시작 셀들의 height 최소값 (rowSpan 1 인 것만)
+    let mut hist: BTreeMap<i64, usize> = BTreeMap::new();
+    let (mut thin, mut thin_empty, mut total) = (0usize, 0usize, 0usize);
+    let mut thin_pt = 0f64;
+    for t in &tables {
+        let mut rows: BTreeMap<u16, (i32, bool)> = BTreeMap::new();
+        for c in &t.cells {
+            if c.row_span != 1 { continue; }
+            let empty = c.paragraphs.iter().all(|p| p.text.trim().is_empty());
+            let e = rows.entry(c.row).or_insert((i32::MAX, true));
+            e.0 = e.0.min(c.height as i32);
+            e.1 &= empty;
+        }
+        for (_r, (h, empty)) in rows {
+            if h == i32::MAX { continue; }
+            total += 1;
+            hist.entry((h as i64 / 500) * 5).and_modify(|v| *v += 1).or_insert(1);
+            if h < 500 {
+                thin += 1;
+                if empty { thin_empty += 1; }
+                // 우리가 한 줄로 부풀릴 때의 손해: 대략 14pt 짜리 줄상자 - 선언 높이
+                thin_pt += 14.0 - (h as f64) / 100.0;
+            }
+        }
+    }
+    let mut lines = vec![
+        format!("tables {}  rows {}", tables.len(), total),
+        format!("rows under 5pt: {thin}   of which every cell is empty: {thin_empty}"),
+        format!("if each such row costs a 14pt line box: {:.0} pt = {:.1} pages of 555.6pt",
+                thin_pt, thin_pt / 555.6),
+        "histogram (row height, 5pt buckets):".into(),
+    ];
+    for (b, n) in hist.iter().take(14) {
+        lines.push(format!("  {:>3}..{:>3} pt   {}", b, b + 5, n));
+    }
+    let out = std::env::var("FMD_THIN_OUT").unwrap_or_else(|_| "/tmp/fmd-thin.txt".into());
+    fs::write(out, lines.join("\n") + "\n").unwrap();
+}
