diff --git a/tests/fmd_cell_margin_probe.rs b/tests/fmd_cell_margin_probe.rs
new file mode 100644
index 000000000..e0cb0f856
--- /dev/null
+++ b/tests/fmd_cell_margin_probe.rs
@@ -0,0 +1,40 @@
+use rhwp::model::control::Control;
+use rhwp::wasm_api::HwpDocument;
+use std::{fs, path::Path};
+
+fn walk<'a>(controls: &'a [Control], out: &mut Vec<&'a rhwp::model::table::Table>) {
+    for c in controls {
+        if let Control::Table(t) = c {
+            out.push(t);
+            for cell in &t.cells {
+                for p in &cell.paragraphs { walk(&p.controls, out); }
+            }
+        }
+    }
+}
+
+#[test]
+fn probe_cell_margins() {
+    let Ok(path) = std::env::var("FMD_CM_DOC") else { return };
+    let bytes = fs::read(Path::new(&path)).expect("read");
+    let doc = HwpDocument::from_bytes(&bytes).expect("parse");
+    let mut tables = Vec::new();
+    for s in &doc.document().sections {
+        for p in &s.paragraphs { walk(&p.controls, &mut tables); }
+    }
+    let mut lines = vec![];
+    for (i, t) in tables.iter().enumerate() {
+        if !(296..=300).contains(&i) { continue; }
+        lines.push(format!("t{i} cols {} rows {} declared {} table-pad {:?}",
+            t.col_count, t.row_count, t.common.width, t.padding));
+        for c in t.cells.iter() {
+            let txt: String = c.paragraphs.iter().flat_map(|p| p.text.chars()).take(20).collect();
+            lines.push(format!(
+                "   r{} c{} span {}x{} w {:<6} h {:<6} apply_inner {:<5} pad {:?} valign {:?} |{}|",
+                c.row, c.col, c.col_span, c.row_span, c.width, c.height,
+                c.apply_inner_margin, c.padding, c.vertical_align, txt));
+        }
+    }
+    let out = std::env::var("FMD_CM_OUT").unwrap_or_else(|_| "/tmp/fmd-cm.txt".into());
+    fs::write(out, lines.join("\n") + "\n").unwrap();
+}
