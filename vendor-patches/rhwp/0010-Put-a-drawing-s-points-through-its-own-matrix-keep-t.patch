@@ -1020,6 +1060,19 @@ fn push_shape_blocks(doc: &Document, shape: &ShapeObject, out: &mut Vec<Block>)
     }
 }
 
+/// Every picture inside a drawing object, including through group nesting.
+fn collect_shape_pictures<'a>(shape: &'a ShapeObject, out: &mut Vec<&'a crate::model::image::Picture>) {
+    match shape {
+        ShapeObject::Picture(picture) => out.push(picture),
+        ShapeObject::Group(group) => {
+            for child in &group.children {
+                collect_shape_pictures(child, out);
+            }
+        }
+        _ => {}
+    }
+}
+
 fn shape_text_box(shape: &ShapeObject) -> Option<&crate::model::shape::TextBox> {
     shape_drawing(shape).and_then(|d| d.text_box.as_ref())
 }
