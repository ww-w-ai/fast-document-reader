@@ -1004,6 +1016,21 @@ fn append_control_blocks(doc: &Document, para: &Paragraph, out: &mut Vec<Block>)
 /// they survive a host that cannot draw the frame, in the SAME vocabulary the body already uses.
 fn push_shape_blocks(doc: &Document, shape: &ShapeObject, out: &mut Vec<Block>) {
     let common = shape.common();
+    // A drawing object that CONTAINS PICTURES is a picture with a frame around it — a screenshot in
+    // a box, which is how a Korean manual illustrates a procedure. The picture is the content and
+    // the frame is decoration, so the picture is what ships: emitting both would stack them, since
+    // this reader places an object inline rather than at coordinates, and the frame would then
+    // reserve a second box the size of the image below it. Measured before this: three consecutive
+    // pages of a real manual rendered as an empty red rectangle and nothing else, because the box
+    // was drawn and the screenshot inside it was dropped.
+    let mut pictures = Vec::new();
+    collect_shape_pictures(shape, &mut pictures);
+    if !pictures.is_empty() {
+        for picture in pictures {
+            out.push(build_image_block(doc, picture));
+        }
+        return;
+    }
     let mut paths = Vec::new();
     collect_shape_paths(shape, 0, 0, &mut paths);
     if !paths.is_empty() {
@@ -1012,6 +1039,19 @@ fn push_shape_blocks(doc: &Document, shape: &ShapeObject, out: &mut Vec<Block>)
             h: common.height as i32,
