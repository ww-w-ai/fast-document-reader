 /// One shape's own path(s), in the object box's coordinates, offset by any group nesting.
 fn collect_shape_paths(shape: &ShapeObject, dx: i32, dy: i32, out: &mut Vec<ShapePath>) {
+    // EVERY point goes through the shape's own affine matrix first. The record stores a line's
+    // endpoints, a polygon's vertices and a curve's controls in the object's ORIGINAL space, and
+    // `ShapeComponentAttr`'s six render coefficients are what rhwp's renderer uses to put them where
+    // they are actually drawn (`layout/shape_layout.rs`'s `transform_pt`). Skipping it does not
+    // merely misplace a shape: measured, a pair of real arrows came out as `M 0,0 L 100,100` —
+    // 1pt specks — because the matrix carried all of their extent.
+    let sa = shape.shape_attr();
+    let (a, b, tx) = (sa.render_sx, sa.render_b, sa.render_tx);
+    let (c, dd, ty) = (sa.render_c, sa.render_sy, sa.render_ty);
+    let tp = |x: i32, y: i32| -> (i32, i32) {
+        let (x, y) = (x as f64, y as f64);
+        (
+            (a * x + b * y + tx).round() as i32 + dx,
+            (c * x + dd * y + ty).round() as i32 + dy,
+        )
+    };
     let mut d: Vec<Vec<serde_json::Value>> = Vec::new();
     match shape {
         ShapeObject::Line(line) => {
-            d.push(pt_cmd("M", &[line.start.x + dx, line.start.y + dy]));
-            d.push(pt_cmd("L", &[line.end.x + dx, line.end.y + dy]));
+            let (sx, sy) = tp(line.start.x, line.start.y);
+            let (ex, ey) = tp(line.end.x, line.end.y);
+            d.push(pt_cmd("M", &[sx, sy]));
+            d.push(pt_cmd("L", &[ex, ey]));
         }
         ShapeObject::Rectangle(rect) => {
             for (i, (x, y)) in rect.x_coords.iter().zip(rect.y_coords.iter()).enumerate() {
-                d.push(pt_cmd(if i == 0 { "M" } else { "L" }, &[*x + dx, *y + dy]));
+                let (px, py) = tp(*x, *y);
+                d.push(pt_cmd(if i == 0 { "M" } else { "L" }, &[px, py]));
             }
             d.push(pt_cmd("Z", &[]));
         }
@@ -1060,9 +1132,11 @@ fn collect_shape_paths(shape: &ShapeObject, dx: i32, dy: i32, out: &mut Vec<Shap
             // A circle/ellipse as four cubic arcs — the standard 0.5523 magic ratio, computed from
             // the centre and the two axis endpoints the record stores, so a rotated ellipse keeps
             // its axes instead of being straightened into a bounding box.
-            let (cx, cy) = (el.center.x + dx, el.center.y + dy);
-            let (ax, ay) = (el.axis1.x - el.center.x, el.axis1.y - el.center.y);
-            let (bx, by) = (el.axis2.x - el.center.x, el.axis2.y - el.center.y);
+            let (cx, cy) = tp(el.center.x, el.center.y);
+            let (a1x, a1y) = tp(el.axis1.x, el.axis1.y);
+            let (a2x, a2y) = tp(el.axis2.x, el.axis2.y);
+            let (ax, ay) = (a1x - cx, a1y - cy);
+            let (bx, by) = (a2x - cx, a2y - cy);
             let k = 0.552_284_75_f64;
             let p = |sx: f64, sy: f64| -> (i32, i32) {
                 (
@@ -1086,13 +1160,15 @@ fn collect_shape_paths(shape: &ShapeObject, dx: i32, dy: i32, out: &mut Vec<Shap
             // honest and coarse. Drawing the true sweep needs the ellipse's own parametrisation,
             // which the record states only indirectly; a straight join is visibly wrong only on a
             // wide sweep, and the alternative (dropping it) is invisible everywhere.
-            d.push(pt_cmd("M", &[arc.center.x + dx, arc.center.y + dy]));
-            d.push(pt_cmd("L", &[arc.axis1.x + dx, arc.axis1.y + dy]));
-            d.push(pt_cmd("L", &[arc.axis2.x + dx, arc.axis2.y + dy]));
+            for (i, p) in [arc.center, arc.axis1, arc.axis2].iter().enumerate() {
+                let (px, py) = tp(p.x, p.y);
+                d.push(pt_cmd(if i == 0 { "M" } else { "L" }, &[px, py]));
+            }
         }
         ShapeObject::Polygon(poly) => {
             for (i, pt) in poly.points.iter().enumerate() {
-                d.push(pt_cmd(if i == 0 { "M" } else { "L" }, &[pt.x + dx, pt.y + dy]));
+                let (px, py) = tp(pt.x, pt.y);
+                d.push(pt_cmd(if i == 0 { "M" } else { "L" }, &[px, py]));
             }
             if poly.points.len() > 2 {
                 d.push(pt_cmd("Z", &[]));
@@ -1100,17 +1176,21 @@ fn collect_shape_paths(shape: &ShapeObject, dx: i32, dy: i32, out: &mut Vec<Shap
         }
         ShapeObject::Curve(curve) => {
             if let Some(first) = curve.points.first() {
-                d.push(pt_cmd("M", &[first.x + dx, first.y + dy]));
+                let (fx, fy) = tp(first.x, first.y);
+                d.push(pt_cmd("M", &[fx, fy]));
                 let mut i = 1;
                 while i + 2 < curve.points.len() {
-                    let (a, b, c) = (&curve.points[i], &curve.points[i + 1], &curve.points[i + 2]);
-                    d.push(pt_cmd("C", &[a.x + dx, a.y + dy, b.x + dx, b.y + dy, c.x + dx, c.y + dy]));
+                    let (p1, p2, p3) = (&curve.points[i], &curve.points[i + 1], &curve.points[i + 2]);
+                    let (x1, y1) = tp(p1.x, p1.y);
+                    let (x2, y2) = tp(p2.x, p2.y);
+                    let (x3, y3) = tp(p3.x, p3.y);
+                    d.push(pt_cmd("C", &[x1, y1, x2, y2, x3, y3]));
                     i += 3;
                 }
                 // A trailing segment shorter than a cubic is joined straight rather than dropped.
                 while i < curve.points.len() {
-                    let pt = &curve.points[i];
-                    d.push(pt_cmd("L", &[pt.x + dx, pt.y + dy]));
+                    let (px, py) = tp(curve.points[i].x, curve.points[i].y);
+                    d.push(pt_cmd("L", &[px, py]));
                     i += 1;
                 }
             }
@@ -1133,10 +1213,14 @@ fn collect_shape_paths(shape: &ShapeObject, dx: i32, dy: i32, out: &mut Vec<Shap
         Some(drawing) => shape_stroke(drawing),
         None => (None, false, false),
     };
+    // A FILL belongs to a closed figure. A line record still carries a fill colour — white, in real
+    // documents — and painting it turns a connector into a white bar that erases the text under it
+    // (measured: it wiped a table's own column label). Only a path that closes is filled.
+    let closed = d.iter().any(|cmd| cmd.first().and_then(|v| v.as_str()) == Some("Z"));
     out.push(ShapePath {
         d,
         stroke,
-        fill: drawing.and_then(shape_fill_hex),
+        fill: if closed { drawing.and_then(shape_fill_hex) } else { None },
         arrow_start,
