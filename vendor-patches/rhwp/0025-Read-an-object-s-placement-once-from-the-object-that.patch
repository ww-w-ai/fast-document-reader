+
+#[cfg(test)]
+mod placement_tests {
+    use super::tests::export;
+    use super::*;
+
+    /// AN OBJECT'S PLACEMENT COMES FROM THE OBJECT THE DOCUMENT PLACED — never from a child.
+    ///
+    /// HWP hangs a `CommonObjAttr` on every node of an object tree, and only the outermost one is a
+    /// placement; a group's children carry defaults (왼쪽/위, 어울림, zero offsets). Reading a
+    /// child's does not fail, it answers plausibly and wrongly, which is why the same defect arrived
+    /// three times in three different fields before `Placement` made it one decision.
+    ///
+    /// `2025 행정업무운영 편람` is the measured case: its foreword frame is a GROUP 476.4pt wide on
+    /// 555.59pt paper, and the group declares 가운데/가운데 while the picture inside it declares the
+    /// defaults. Reading the child drew the frame at the paper's left edge — the whole page 39.6pt
+    /// out, ((555.59 − 476.4) / 2).
+    #[test]
+    fn a_nested_picture_is_placed_by_the_object_that_holds_it() {
+        const SAMPLE: &str = "samples/2025 행정업무운영 편람(최종).hwp";
+        if !std::path::Path::new(SAMPLE).exists() {
+            eprintln!("skipping: {SAMPLE} not present");
+            return;
+        }
+        let json = export(SAMPLE);
+        let doc: serde_json::Value = serde_json::from_str(&json).expect("valid json");
+        let blocks = doc["blocks"].as_array().expect("blocks");
+
+        // The foreword frame: 476.4 × 688.8pt, in HWPUNIT.
+        let frame = blocks
+            .iter()
+            .find(|b| b["t"] == "image" && b["w"] == 47640 && b["h"] == 68880)
+            .expect("the foreword frame must be exported");
+
+        // The GROUP's own declaration, not the picture's defaults.
+        assert_eq!(frame["horzAlign"], "center", "the document centres this frame");
+        assert_eq!(frame["vertAlign"], "center");
+        assert_eq!(frame["horzRelTo"], "paper");
+        assert_eq!(frame["vertRelTo"], "paper");
+        // 글 앞으로: painted over the text, holding no space. The picture inside it says 위아래.
+        assert!(
+            frame["wrapsText"].is_null(),
+            "a 글 앞으로 group must not report its child's 위아래 wrap"
+        );
+        assert_eq!(frame["asChar"], false);
+
+        // And the cover, which IS a top-level picture, still reads its own — the same code path has
+        // to be right for an object with no group around it at all.
+        let cover = blocks
+            .iter()
+            .find(|b| b["t"] == "image" && b["w"] == 53880 && b["h"] == 73680)
+            .expect("the cover must be exported");
+        assert_eq!(cover["horzAlign"], "center");
+        assert_eq!(cover["vertAlign"], "center");
+    }
+}
