+/// WHERE THE DOCUMENT PUT AN OBJECT, and whether that object holds space in the text.
+///
+/// This exists because the same defect kept arriving one field at a time. HWP's object tree carries
+/// a `CommonObjAttr` on every node, but only ONE of them is a placement: the node the document
+/// actually positioned — the OUTERMOST object. A group's children carry a `CommonObjAttr` of
+/// leftover defaults (어울림 for the wrap, 왼쪽/위 for the alignment, zero offsets, zero size), and
+/// their real geometry is in their render matrices instead. Reading a child's therefore does not
+/// fail loudly; it quietly answers "top-left, in the flow", which is a plausible-looking lie.
+///
+/// Measured, three times, each time as a separate bug before this type existed:
+///   * the wrap → the 편람's cover went back into the text and the document grew 520 pages to 529;
+///   * the alignment → the same file's foreword frame was drawn at the paper's left edge when the
+///     document centres it, putting the whole page 39.6pt out ((555.59 − 476.4) / 2);
+///   * and the offsets and reference edges ride on the same attribute, so they were wrong with it.
+///
+/// So placement is read ONCE, from the object the document placed, and handed to everything that
+/// object emits — at any nesting depth, because the depth never changes the answer. A caller cannot
+/// forget: every block that carries an anchor takes this value rather than an object to read it off.
+#[derive(Clone, Copy)]
+struct Placement {
+    as_char: bool,
+    wraps_text: bool,
+    vert_rel_to: &'static str,
+    horz_rel_to: &'static str,
+    vert_align: &'static str,
+    horz_align: &'static str,
+    offset_x: i32,
+    offset_y: i32,
+}
+
+impl Placement {
+    /// The ONLY way to make one. Call it on the object the document placed — `push_shape_blocks`'s
+    /// own `shape`, or a picture that is itself a top-level control — never on a group's child.
+    fn of(common: &crate::model::shape::CommonObjAttr) -> Self {
+        Placement {
+            as_char: common.treat_as_char,
+            wraps_text: occupies_flow(common.text_wrap),
+            vert_rel_to: vert_rel_to_str(common.vert_rel_to),
+            horz_rel_to: horz_rel_to_str(common.horz_rel_to),
+            vert_align: vert_align_str(common.vert_align),
+            horz_align: horz_align_str(common.horz_align),
+            offset_x: common.horizontal_offset as i32,
+            offset_y: common.vertical_offset as i32,
+        }
+    }
+}
+
 /// Which edge (or centre) of the reference area an anchored object's offset is measured from.
 fn vert_align_str(a: crate::model::shape::VertAlign) -> &'static str {
     use crate::model::shape::VertAlign;
@@ -1402,7 +1452,10 @@ fn append_control_blocks(doc: &Document, para: &Paragraph, out: &mut Vec<Block>)
     for ctrl in &para.controls {
         match ctrl {
             Control::Table(t) => out.push(build_table_block(doc, t)),
-            Control::Picture(p) => out.push(build_image_block(doc, p)),
+            Control::Picture(p) => {
+                let placement = Placement::of(&p.common);
+                out.push(build_image_block(doc, p, placement))
+            }
             Control::Equation(e) => out.push(build_equation_block(e)),
             Control::Shape(s) => push_shape_blocks(doc, s, out),
             _ => {}
@@ -1420,6 +1473,10 @@ fn append_control_blocks(doc: &Document, para: &Paragraph, out: &mut Vec<Block>)
 /// they survive a host that cannot draw the frame, in the SAME vocabulary the body already uses.
 fn push_shape_blocks(doc: &Document, shape: &ShapeObject, out: &mut Vec<Block>) {
     let common = shape.common();
+    // THE object the document placed. Everything this call emits — the pictures inside it at any
+    // depth, its own flattened paths — is placed by this one answer, never by a child's own
+    // attributes (see `Placement`).
+    let placement = Placement::of(common);
     // A drawing object that CONTAINS PICTURES is a picture with a frame around it — a screenshot in
     // a box, which is how a Korean manual illustrates a procedure. The picture is the content and
     // the frame is decoration, so the picture is what ships: emitting both would stack them, since
@@ -1431,15 +1488,7 @@ fn push_shape_blocks(doc: &Document, shape: &ShapeObject, out: &mut Vec<Block>)
     collect_shape_pictures(shape, &mut pictures);
     if !pictures.is_empty() {
         for picture in pictures {
-            let mut block = build_image_block(doc, picture);
-            // Whether the object holds space in the flow is the OUTERMOST object's answer, not the
-            // child's. A group child's own `text_wrap` is leftover state: the 편람's cover container
-            // says 글 앞으로 while the picture inside it still says 위아래, and reading the child put
-            // a full-page cover back into the text — 520 pages became 529.
-            if let Block::Image(ref mut image) = block {
-                image.wraps_text = occupies_flow(common.text_wrap);
-            }
-            out.push(block);
+            out.push(build_image_block(doc, picture, placement));
         }
         // …and the WORDS the same object carries, which returning here used to throw away. A cover
         // page is one group holding the artwork AND the title, and a foreword page is a group whose
@@ -1454,24 +1503,15 @@ fn push_shape_blocks(doc: &Document, shape: &ShapeObject, out: &mut Vec<Block>)
         out.push(Block::Shape(ShapeBlock {
             w: common.width as i32,
             h: common.height as i32,
-            align: horz_align_str(common.horz_align),
-            as_char: common.treat_as_char,
-            wraps_text: occupies_flow(common.text_wrap),
-            vert_rel_to: match common.vert_rel_to {
-                crate::model::shape::VertRelTo::Paper => "paper",
-                crate::model::shape::VertRelTo::Page => "page",
-                crate::model::shape::VertRelTo::Para => "para",
-            },
-            horz_rel_to: match common.horz_rel_to {
-                crate::model::shape::HorzRelTo::Paper => "paper",
-                crate::model::shape::HorzRelTo::Page => "page",
-                crate::model::shape::HorzRelTo::Column => "column",
-                crate::model::shape::HorzRelTo::Para => "para",
-            },
-            offset_x: common.horizontal_offset as i32,
-            offset_y: common.vertical_offset as i32,
-            vert_align: vert_align_str(common.vert_align),
-            horz_align: horz_align_str(common.horz_align),
+            align: placement.horz_align,
+            as_char: placement.as_char,
+            wraps_text: placement.wraps_text,
+            vert_rel_to: placement.vert_rel_to,
+            horz_rel_to: placement.horz_rel_to,
+            offset_x: placement.offset_x,
+            offset_y: placement.offset_y,
+            vert_align: placement.vert_align,
+            horz_align: placement.horz_align,
             paths,
         }));
     }
@@ -2108,7 +2148,7 @@ impl DocumentCore {
 mod tests {
     use super::*;
 
-    fn export(path: &str) -> String {
+    pub(super) fn export(path: &str) -> String {
         let data = std::fs::read(path).unwrap_or_else(|e| panic!("read {path}: {e}"));
         let core = DocumentCore::from_bytes(&data)
             .unwrap_or_else(|e| panic!("parse {path}: {e:?}"));
@@ -2296,3 +2336,59 @@ mod tests {
