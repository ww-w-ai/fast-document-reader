-        wraps_text: occupies_flow(pic.common.text_wrap),
-        vert_rel_to: vert_rel_to_str(pic.common.vert_rel_to),
-        horz_rel_to: horz_rel_to_str(pic.common.horz_rel_to),
-        vert_align: vert_align_str(pic.common.vert_align),
-        horz_align: horz_align_str(pic.common.horz_align),
