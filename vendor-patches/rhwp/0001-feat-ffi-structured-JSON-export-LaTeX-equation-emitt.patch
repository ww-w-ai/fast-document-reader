+//! 뷰어 브리지용 구조화 JSON 익스포트 (Task: structured-export FFI).
+//!
+//! 파싱된 HWP/HWPX 문서를 **페이지 분할 없이** 구역→문단 연속 흐름으로 순회해,
+//! 스타일이 해소된(style-resolved) 평탄한 JSON 블록 배열로 내보낸다. Swift 뷰어가
+//! 소비한다. `structure.rs` 패턴을 그대로 따라, 익스포터 소유의
+//! `#[derive(serde::Serialize)]` DTO 를 이 파일에 정의하고 채운다 —
+//! `model/` 타입에는 serde 를 붙이지 않는다.
+//!
+//! 파서/렌더 무변경의 읽기 전용 질의.
+
+use serde::Serialize;
+
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::control::{Control, FieldType};
+use crate::model::document::{DocInfo, Document};
+use crate::model::page::PageAreas;
+use crate::model::paragraph::Paragraph;
+use crate::model::style::{Alignment, HeadType, LineSpacingType, UnderlineType};
+use crate::model::table::{Cell, Table, VerticalAlign};
+use crate::renderer::equation::latex::to_latex;
+use crate::renderer::equation::parser::EqParser;
+use crate::renderer::equation::tokenizer::tokenize;
+use crate::renderer::style_resolver::lookup_font_name;
+
+/// 최상위 결과.
+#[derive(Serialize)]
+struct DocumentJson {
+    v: u32,
+    /// 문서의 기본 본문 글자 크기(pt). 첫 본문 문단의 char_shape(없으면 char_shape 0)의
+    /// base_size(HWPUNIT) ÷ 100 — 렌더러의 char_shape 해소 경로를 그대로 따른다. char_shapes 가
+    /// 진짜로 비어 있을 때만 null → Swift 뷰어가 11pt 로 폴백. docx `w:docDefaults/…/w:sz`,
+    /// odt 기본 텍스트 스타일과 같은 역할.
+    #[serde(rename = "defaultFontSizePt")]
+    default_font_size_pt: Option<f64>,
+    /// 첫 구역의 페이지 본문폭(pt) — 용지폭 − 좌우여백, 방향(landscape)·제본·gutter 반영.
+    /// 렌더러가 실제 쓰는 `PageAreas::from_page_def().body_area` 폭이라 A4 폴백·여백과대
+    /// 방어까지 동일하게 적용된다. 구역이 없거나 폭이 0 이하일 때만 null → Swift 뷰어가
+    /// 창폭 채움으로 폴백. docx `w:sectPr`(pgSz−pgMar), odt page-layout 과 같은 역할.
+    #[serde(rename = "pageContentWidth")]
+    page_content_width: Option<f64>,
+    blocks: Vec<Block>,
+}
+
+/// 문서의 기본 본문 글자 크기(pt)를 구한다.
+///
+/// rhwp 렌더러는 크기를 `doc_info.styles` 에서 구하지 않는다(스타일 레코드 파싱이 어긋나면
+/// 엉뚱한 char_shape_id 를 줘서 out-of-range → None 이 되는 취약한 경로다). 렌더러는 문단
+/// 자신의 `CharShapeRef` 에서 char_shape_id 를 해소하고, 없으면 char_shape 0 으로 폴백한다
+/// (`composer.rs` `find_active_char_shape` → `unwrap_or(0)`). 그 동작을 그대로 반영한다:
+///
+/// 1. 첫 본문 문단(구역 순회)의 첫 `CharShapeRef` 의 char_shape_id 를 취한다.
+/// 2. 그런 참조가 없거나 그 id 가 범위를 벗어나면 char_shape 0 으로 폴백(렌더러의 `unwrap_or(0)`).
+/// 3. `base_size`(HWPUNIT) ÷ 100 = pt. `base_size` 는 짧은 레코드 읽기 시 1000(10pt)으로 기본값이
+///    잡히므로 정상 문서는 실제 숫자를 낸다. `char_shapes` 가 진짜로 비어 있을 때만 None(뷰어 폴백).
+fn default_body_font_size_pt(document: &Document) -> Option<f64> {
+    let char_shape_id = document
+        .sections
+        .iter()
+        .flat_map(|section| section.paragraphs.iter())
+        .find_map(|para| para.char_shapes.first())
+        .map(|cs_ref| cs_ref.char_shape_id as usize)
+        .unwrap_or(0);
+    let char_shapes = &document.doc_info.char_shapes;
+    let cs = char_shapes.get(char_shape_id).or_else(|| char_shapes.first())?;
+    Some(cs.base_size as f64 / 100.0)
+}
+
+/// 문서의 페이지 본문폭(pt)을 구한다.
+///
+/// 첫 구역의 `PageDef` 에서 렌더러와 동일한 `PageAreas::from_page_def` 로 본문 영역을 계산해
+/// 그 폭(HWPUNIT)을 ÷100 하여 pt 로 낸다. 이 경로는 landscape(가로) width/height 교환, 제본
+/// (gutter)·양면 여백, 그리고 손상/과대여백 방어(A4 폴백)를 이미 처리한다 — Swift 뷰어가 오피스
+/// 문서 읽기 컬럼을 이 폭에 고정(min(폭, 창폭))하는 데 쓴다. 구역이 없거나 폭이 0 이하이면 None.
+fn page_content_width_pt(document: &Document) -> Option<f64> {
+    let section = document.sections.first()?;
+    let areas = PageAreas::from_page_def(&section.section_def.page_def);
+    let width = areas.body_area.width();
+    if width <= 0 {
+        return None;
+    }
+    Some(width as f64 / 100.0)
+}
+
+/// 블록 종류. `t` 태그로 판별. para/heading 은 한 종류(`para`), heading 필드로 구분.
+#[derive(Serialize)]
+#[serde(tag = "t", rename_all = "lowercase")]
+enum Block {
+    Para(ParaBlock),
+    Table(TableBlock),
+    Image(ImageBlock),
+    Equation(EquationBlock),
+    Unsupported(UnsupportedBlock),
+}
+
+#[derive(Serialize)]
+struct ParaBlock {
+    /// null = 본문 문단, 그 외 = 제목 수준(1-based).
+    heading: Option<i32>,
+    /// 문단이 참조하는 스타일의 영문 이름(예: "Outline 1", "Title"). 로케일에 무관하게
+    /// 안정적이라 호스트가 제목 스타일을 판정하는 기준으로 쓴다. 스타일 없음/미해결 시 null.
+    #[serde(rename = "styleName", skip_serializing_if = "Option::is_none")]
+    style_name: Option<String>,
+    /// 스타일의 한글 이름(예: "개요 1", "제목"). 영문 이름이 비어 있는 문서를 위한 보조 신호.
+    #[serde(rename = "styleLocalName", skip_serializing_if = "Option::is_none")]
+    style_local_name: Option<String>,
+    spans: Vec<Span>,
+    align: &'static str,
+    #[serde(rename = "indentStart")]
+    indent_start: i32,
+    #[serde(rename = "indentEnd")]
+    indent_end: i32,
+    #[serde(rename = "indentFirst")]
+    indent_first: i32,
+    #[serde(rename = "spaceBefore")]
+    space_before: i32,
+    #[serde(rename = "spaceAfter")]
+    space_after: i32,
+    #[serde(rename = "lineHeight")]
+    line_height: LineHeight,
+    list: Option<ListInfo>,
+}
+
+#[derive(Serialize)]
+struct LineHeight {
