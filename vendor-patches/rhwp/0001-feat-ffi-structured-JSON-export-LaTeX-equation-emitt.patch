 use std::ffi::{CStr, CString};
 use std::fs;
-use std::os::raw::c_char;
+use std::os::raw::{c_char, c_void};
 use std::path::{Path, PathBuf};
 
+use base64::Engine;
 use rhwp_core::wasm_api::HwpDocument;
 
 const ALL_PAGES: i32 = -1;
 
+// === Handle-based structured export (parse once, query many, free once) ===
+//
+// `rhwp_open` parses bytes into a boxed `HwpDocument` and returns an opaque
+// handle. `rhwp_document_json` walks the whole document as a continuous
+// section→paragraph flow and returns style-resolved JSON (see
+// `document_core::queries::document_json`). `rhwp_image_base64` returns the
+// base64 of an image's bytes by 1-based bin_data_id. `rhwp_close` frees it.
+// Every returned string must be freed with `rhwp_string_free`.
+
+/// Parse `bytes[0..len]` into a document handle. Returns null on parse error
+/// (or null/zero input). Free with `rhwp_close`.
+#[no_mangle]
+pub extern "C" fn rhwp_open(bytes: *const u8, len: usize) -> *mut c_void {
+    if bytes.is_null() || len == 0 {
+        return std::ptr::null_mut();
+    }
+    let slice = unsafe { std::slice::from_raw_parts(bytes, len) };
+    match std::panic::catch_unwind(|| HwpDocument::from_bytes(slice)) {
+        Ok(Ok(doc)) => Box::into_raw(Box::new(doc)) as *mut c_void,
+        _ => std::ptr::null_mut(),
+    }
+}
+
+/// Structured document JSON (`{"v":1,"blocks":[...]}`). Returns an error-JSON
+/// string on failure, or null if the handle is null. Free with `rhwp_string_free`.
+#[no_mangle]
+pub extern "C" fn rhwp_document_json(handle: *mut c_void) -> *mut c_char {
+    if handle.is_null() {
+        return std::ptr::null_mut();
+    }
+    let doc = unsafe { &*(handle as *const HwpDocument) };
+    let json = match doc.export_document_json() {
+        Ok(json) => json,
+        Err(error) => error_json(&format!("구조화 JSON 익스포트 실패: {error:?}")),
+    };
+    CString::new(json)
+        .unwrap_or_else(|_| {
+            CString::new(error_json("결과 문자열에 NUL 문자가 포함되었습니다.")).unwrap()
+        })
+        .into_raw()
+}
+
+/// Base64 of the image bytes for `bin_data_id` (1-based). Empty string ("") if
+/// none/unresolvable. Returns null if the handle is null. Free with `rhwp_string_free`.
+#[no_mangle]
+pub extern "C" fn rhwp_image_base64(handle: *mut c_void, bin_data_id: u16) -> *mut c_char {
+    if handle.is_null() {
+        return std::ptr::null_mut();
+    }
+    let doc = unsafe { &*(handle as *const HwpDocument) };
+    let b64 = match doc.get_bin_data_image_data_native(bin_data_id) {
+        Ok(bytes) => base64::engine::general_purpose::STANDARD.encode(bytes),
+        Err(_) => String::new(),
+    };
+    CString::new(b64)
+        .unwrap_or_else(|_| CString::new("").unwrap())
+        .into_raw()
+}
+
+/// Free a document handle returned by `rhwp_open`.
+#[no_mangle]
+pub extern "C" fn rhwp_close(handle: *mut c_void) {
+    if handle.is_null() {
+        return;
+    }
+    unsafe {
+        drop(Box::from_raw(handle as *mut HwpDocument));
+    }
+}
+
