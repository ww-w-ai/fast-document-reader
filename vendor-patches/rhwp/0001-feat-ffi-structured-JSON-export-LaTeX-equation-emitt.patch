+++ b/src/renderer/equation/latex.rs
@@ -0,0 +1,451 @@
+//! 수식 AST(EqNode) → LaTeX 문자열 변환기 (structured-export 용).
+//!
+//! `to_latex` 는 파서가 만든 `EqNode` 트리를 LaTeX 로 직렬화한다. 뷰어(Swift)가
+//! KaTeX 로 렌더링할 수 있게 하기 위한 것으로, SVG 렌더러와 독립적이다.
+//!
+//! 설계 원칙 — **정직한 저하(honest degrade)**: 매핑되지 않는 이색적인 변형
+//! (EqAlign/Color/희귀 장식/미지 기호)은 깨진 LaTeX 대신 원본 텍스트/유니코드를
+//! 그대로 내보낸다. 목표 커버리지 80~90%, 이색적 꼬리는 저하로 처리한다.
+
+use super::ast::{EqNode, MatrixStyle, PileAlign, SpaceKind};
+use super::symbols::{DecoKind, FontStyleKind};
+
+/// EqNode 트리를 LaTeX 문자열로 변환한다.
+pub fn to_latex(node: &EqNode) -> String {
+    match node {
+        EqNode::Row(children) => children
+            .iter()
+            .map(to_latex)
+            .filter(|s| !s.is_empty())
+            .collect::<Vec<_>>()
+            .join(" "),
+
+        EqNode::Text(s) => escape_text(s),
+        EqNode::Number(s) => s.clone(),
+        EqNode::Symbol(s) => escape_symbol(s),
+        EqNode::MathSymbol(s) => math_symbol_to_latex(s),
+        EqNode::Function(f) => function_to_latex(f),
+
+        EqNode::Fraction { numer, denom } => {
+            format!("\\frac{{{}}}{{{}}}", to_latex(numer), to_latex(denom))
+        }
+        EqNode::Atop { top, bottom } => {
+            format!("{{{} \\atop {}}}", to_latex(top), to_latex(bottom))
+        }
+
+        EqNode::Sqrt { index, body } => match index {
+            Some(idx) => format!("\\sqrt[{}]{{{}}}", to_latex(idx), to_latex(body)),
+            None => format!("\\sqrt{{{}}}", to_latex(body)),
+        },
+
+        EqNode::Superscript { base, sup } => {
+            format!("{}^{{{}}}", to_latex(base), to_latex(sup))
+        }
+        EqNode::Subscript { base, sub } => {
+            format!("{}_{{{}}}", to_latex(base), to_latex(sub))
+        }
+        EqNode::SubSup { base, sub, sup } => {
+            format!("{}_{{{}}}^{{{}}}", to_latex(base), to_latex(sub), to_latex(sup))
+        }
+
+        EqNode::BigOp { symbol, sub, sup } => {
+            let mut out = math_symbol_to_latex(symbol);
+            if let Some(sub) = sub {
+                out.push_str(&format!("_{{{}}}", to_latex(sub)));
+            }
+            if let Some(sup) = sup {
+                out.push_str(&format!("^{{{}}}", to_latex(sup)));
+            }
+            out
+        }
+
+        EqNode::Limit { is_upper, sub } => {
+            let base = if *is_upper { "\\varlimsup" } else { "\\lim" };
+            match sub {
+                Some(sub) => format!("{}_{{{}}}", base, to_latex(sub)),
+                None => base.to_string(),
+            }
+        }
+
+        EqNode::Matrix { rows, style } => {
+            let env = match style {
+                MatrixStyle::Plain => "matrix",
+                MatrixStyle::Paren => "pmatrix",
+                MatrixStyle::Bracket => "bmatrix",
+                MatrixStyle::Vert => "vmatrix",
+            };
+            let body = rows
+                .iter()
+                .map(|row| {
+                    row.iter()
+                        .map(to_latex)
+                        .collect::<Vec<_>>()
+                        .join(" & ")
+                })
+                .collect::<Vec<_>>()
+                .join(" \\\\ ");
+            format!("\\begin{{{env}}} {body} \\end{{{env}}}")
+        }
+
+        EqNode::Cases { rows } => {
+            let body = rows
+                .iter()
+                .map(to_latex)
+                .collect::<Vec<_>>()
+                .join(" \\\\ ");
+            format!("\\begin{{cases}} {body} \\end{{cases}}")
+        }
+
+        EqNode::Pile { rows, align } => {
+            // 단일 열 세로 쌓기 → matrix 로 저하(정렬은 무시).
+            let _ = align;
+            let body = rows
+                .iter()
+                .map(to_latex)
+                .collect::<Vec<_>>()
+                .join(" \\\\ ");
+            format!("\\begin{{matrix}} {body} \\end{{matrix}}")
+        }
+
+        EqNode::EqAlign { rows } => {
+            // aligned 환경으로 근사(정렬 & 유지). 저하 허용 범위.
+            let body = rows
+                .iter()
+                .map(|(l, r)| format!("{} & {}", to_latex(l), to_latex(r)))
+                .collect::<Vec<_>>()
+                .join(" \\\\ ");
+            format!("\\begin{{aligned}} {body} \\end{{aligned}}")
+        }
+
+        EqNode::Rel { arrow, over, under } => {
+            // 화살표 위/아래 배치 → overset/underset 근사.
+            let arrow_tex = math_symbol_to_latex(arrow);
+            match under {
+                Some(under) => format!(
+                    "\\underset{{{}}}{{\\overset{{{}}}{{{}}}}}",
+                    to_latex(under),
+                    to_latex(over),
+                    arrow_tex
+                ),
+                None => format!("\\overset{{{}}}{{{}}}", to_latex(over), arrow_tex),
+            }
+        }
+
+        EqNode::Paren { left, right, body } => {
+            format!(
+                "\\left{} {} \\right{}",
+                bracket_to_latex(left),
+                to_latex(body),
+                bracket_to_latex(right)
+            )
+        }
+
+        EqNode::Decoration { kind, body } => {
+            format!("{}{{{}}}", deco_to_latex(*kind), to_latex(body))
+        }
+
+        EqNode::FontStyle { style, body } => {
+            format!("{}{{{}}}", font_style_to_latex(*style), to_latex(body))
+        }
+
+        // 색상은 저하: 본문만 내보낸다.
+        EqNode::Color { body, .. } => to_latex(body),
+
+        EqNode::Space(kind) => match kind {
+            SpaceKind::Normal => "\\ ".to_string(),
+            SpaceKind::Thin => "\\,".to_string(),
+            SpaceKind::Tab => "\\quad ".to_string(),
+        },
+
+        EqNode::Newline => "\\\\ ".to_string(),
+        EqNode::Quoted(s) => format!("\\text{{{}}}", escape_text(s)),
+        EqNode::Empty => String::new(),
+    }
+}
+
+/// LaTeX 특수문자를 최소한으로 escape (텍스트 노드용).
+fn escape_text(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for ch in s.chars() {
+        match ch {
+            '{' => out.push_str("\\{"),
+            '}' => out.push_str("\\}"),
+            '\\' => out.push_str("\\backslash "),
+            '$' => out.push_str("\\$"),
+            '%' => out.push_str("\\%"),
+            '#' => out.push_str("\\#"),
+            '&' => out.push_str("\\&"),
+            '_' => out.push_str("\\_"),
+            _ => out.push(ch),
+        }
+    }
+    out
+}
+
+/// 단일 연산/구두점 기호 escape.
+fn escape_symbol(s: &str) -> String {
+    match s {
+        "{" => "\\{".to_string(),
+        "}" => "\\}".to_string(),
+        "%" => "\\%".to_string(),
+        "#" => "\\#".to_string(),
+        "&" => "\\&".to_string(),
+        "_" => "\\_".to_string(),
+        "$" => "\\$".to_string(),
+        _ => s.to_string(),
+    }
+}
+
+/// 함수 이름을 LaTeX 명령으로. 표준 함수는 `\sin` 등, 그 외는 `\operatorname`.
+fn function_to_latex(f: &str) -> String {
+    const STD: &[&str] = &[
+        "sin", "cos", "tan", "cot", "sec", "csc", "arcsin", "arccos", "arctan", "sinh", "cosh",
+        "tanh", "coth", "log", "ln", "lg", "exp", "det", "dim", "ker", "hom", "arg", "deg", "gcd",
+        "max", "min", "sup", "inf", "lim", "Pr",
+    ];
+    if STD.contains(&f) {
+        format!("\\{f}")
+    } else {
+        format!("\\operatorname{{{f}}}")
+    }
+}
+
+/// 자동 크기 괄호 문자를 `\left`/`\right` 뒤에 올 LaTeX 로.
+fn bracket_to_latex(b: &str) -> String {
+    match b {
+        "" => ".".to_string(),
+        "{" => "\\{".to_string(),
+        "}" => "\\}".to_string(),
+        "‖" => "\\|".to_string(),
+        "⟨" => "\\langle".to_string(),
+        "⟩" => "\\rangle".to_string(),
+        "⌈" => "\\lceil".to_string(),
+        "⌉" => "\\rceil".to_string(),
+        "⌊" => "\\lfloor".to_string(),
+        "⌋" => "\\rfloor".to_string(),
+        other => other.to_string(), // ( ) [ ] | . 등은 그대로
+    }
+}
+
+/// 글자 장식 → LaTeX 명령.
+fn deco_to_latex(kind: DecoKind) -> &'static str {
+    match kind {
+        DecoKind::Hat => "\\hat",
+        DecoKind::Check => "\\check",
+        DecoKind::Tilde => "\\tilde",
+        DecoKind::Acute => "\\acute",
+        DecoKind::Grave => "\\grave",
+        DecoKind::Dot => "\\dot",
+        DecoKind::DDot => "\\ddot",
+        DecoKind::Bar => "\\bar",
+        DecoKind::Vec => "\\vec",
+        DecoKind::Dyad => "\\overleftrightarrow",
+        DecoKind::Under => "\\underbrace",
+        DecoKind::Arch => "\\overparen",
+        DecoKind::Underline => "\\underline",
+        DecoKind::Overline => "\\overline",
+        DecoKind::StrikeThrough => "\\cancel",
+    }
+}
+
+/// 글꼴 스타일 → LaTeX 명령.
+fn font_style_to_latex(style: FontStyleKind) -> &'static str {
+    match style {
+        FontStyleKind::Roman => "\\mathrm",
+        FontStyleKind::Italic => "\\mathit",
+        FontStyleKind::Bold => "\\mathbf",
+        FontStyleKind::Blackboard => "\\mathbb",
+        FontStyleKind::Calligraphy => "\\mathcal",
+        FontStyleKind::Fraktur => "\\mathfrak",
+        FontStyleKind::SansSerif => "\\mathsf",
+        FontStyleKind::Monospace => "\\mathtt",
+    }
+}
+
+/// 유니코드 수학 기호 → LaTeX 명령. 매핑 없으면 유니코드 그대로(정직한 저하).
+fn math_symbol_to_latex(s: &str) -> String {
+    let mapped = match s {
+        // 큰 연산자 / 적분
+        "∫" => "\\int",
+        "∬" => "\\iint",
+        "∭" => "\\iiint",
+        "∮" => "\\oint",
+        "∑" => "\\sum",
+        "∏" => "\\prod",
+        "∐" => "\\coprod",
+        "⋀" => "\\bigwedge",
+        "⋁" => "\\bigvee",
+        "⊕" => "\\oplus",
+        "⊗" => "\\otimes",
+        "⊙" => "\\odot",
+        "⊔" => "\\sqcup",
+        "⊓" => "\\sqcap",
+        "⊎" => "\\uplus",
+        // 관계 / 산술
+        "∞" => "\\infty",
+        "×" => "\\times",
+        "÷" => "\\div",
+        "±" => "\\pm",
+        "∓" => "\\mp",
+        "·" => "\\cdot",
+        "∘" => "\\circ",
+        "•" => "\\bullet",
+        "∗" => "\\ast",
+        "≤" => "\\leq",
+        "≥" => "\\geq",
+        "≠" => "\\neq",
+        "≈" => "\\approx",
+        "≡" => "\\equiv",
+        "≅" => "\\cong",
+        "∼" => "\\sim",
+        "≃" => "\\simeq",
+        "≪" => "\\ll",
+        "≫" => "\\gg",
+        "∝" => "\\propto",
+        "≐" => "\\doteq",
+        // 화살표
+        "→" => "\\rightarrow",
+        "←" => "\\leftarrow",
+        "↔" => "\\leftrightarrow",
+        "⇒" => "\\Rightarrow",
+        "⇐" => "\\Leftarrow",
+        "⇔" => "\\Leftrightarrow",
+        "↑" => "\\uparrow",
+        "↓" => "\\downarrow",
+        "↦" => "\\mapsto",
+        "⟶" => "\\longrightarrow",
+        "⟵" => "\\longleftarrow",
+        // 집합 / 논리
+        "∈" => "\\in",
+        "∉" => "\\notin",
+        "∋" => "\\ni",
+        "⊂" => "\\subset",
+        "⊃" => "\\supset",
+        "⊆" => "\\subseteq",
+        "⊇" => "\\supseteq",
+        "∪" => "\\cup",
+        "∩" => "\\cap",
+        "∀" => "\\forall",
+        "∃" => "\\exists",
+        "∄" => "\\nexists",
+        "∅" => "\\emptyset",
+        "∧" => "\\wedge",
+        "∨" => "\\vee",
+        "¬" => "\\neg",
+        "∂" => "\\partial",
+        "∇" => "\\nabla",
+        "∴" => "\\therefore",
+        "∵" => "\\because",
+        "⊢" => "\\vdash",
+        "⊨" => "\\models",
+        "⊥" => "\\perp",
+        "†" => "\\dagger",
+        "‡" => "\\ddagger",
+        "★" => "\\star",
+        "⋯" => "\\cdots",
+        "…" => "\\ldots",
+        "⋮" => "\\vdots",
+        "⋱" => "\\ddots",
+        "ℵ" => "\\aleph",
+        "ℏ" => "\\hbar",
+        "ℓ" => "\\ell",
+        "℘" => "\\wp",
+        "ℑ" => "\\Im",
+        "ℜ" => "\\Re",
+        "∠" => "\\angle",
+        "°" => "\\degree",
+        "′" => "\\prime",
+        "‖" => "\\|",
+        // 그리스 소문자
+        "α" => "\\alpha",
+        "β" => "\\beta",
+        "γ" => "\\gamma",
+        "δ" => "\\delta",
+        "ε" => "\\epsilon",
+        "ζ" => "\\zeta",
+        "η" => "\\eta",
+        "θ" => "\\theta",
+        "ϑ" => "\\vartheta",
+        "ι" => "\\iota",
+        "κ" => "\\kappa",
+        "λ" => "\\lambda",
+        "μ" => "\\mu",
+        "ν" => "\\nu",
+        "ξ" => "\\xi",
+        "ο" => "o",
+        "π" => "\\pi",
+        "ϖ" => "\\varpi",
+        "ρ" => "\\rho",
+        "σ" => "\\sigma",
+        "ς" => "\\varsigma",
+        "τ" => "\\tau",
+        "υ" => "\\upsilon",
+        "φ" => "\\phi",
+        "χ" => "\\chi",
+        "ψ" => "\\psi",
+        "ω" => "\\omega",
+        // 그리스 대문자
+        "Γ" => "\\Gamma",
+        "Δ" => "\\Delta",
+        "Θ" => "\\Theta",
+        "Λ" => "\\Lambda",
+        "Ξ" => "\\Xi",
+        "Π" => "\\Pi",
+        "Σ" => "\\Sigma",
+        "Υ" => "\\Upsilon",
+        "Φ" => "\\Phi",
+        "Ψ" => "\\Psi",
+        "Ω" => "\\Omega",
+        _ => "",
+    };
+    if mapped.is_empty() {
+        // 정직한 저하: 매핑 없으면 유니코드 문자 그대로.
+        s.to_string()
+    } else {
+        // 명령 뒤에 공백을 붙여 뒤 토큰과 붙지 않게 한다(`\pi x`).
+        format!("{mapped} ")
+            .trim_end()
+            .to_string()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::renderer::equation::parser::EqParser;
+    use crate::renderer::equation::tokenizer::tokenize;
+
+    fn latex(script: &str) -> String {
+        let tokens = tokenize(script);
+        let ast = EqParser::new(tokens).parse();
+        to_latex(&ast)
+    }
+
+    #[test]
+    fn fraction_over() {
+        let out = latex("a over b");
+        assert!(out.contains("\\frac"), "expected \\frac in: {out}");
+    }
+
+    #[test]
+    fn left_right_fraction_super() {
+        let out = latex("LEFT ( {1} over {6} RIGHT )^4");
+        assert!(out.contains("\\left("), "expected \\left( in: {out}");
+        assert!(out.contains("\\frac"), "expected \\frac in: {out}");
+    }
+
+    #[test]
+    fn integral_with_limits() {
+        let out = latex("int _{0} ^{pi} x dx");
+        assert!(out.contains("\\int"), "expected \\int in: {out}");
+        assert!(out.contains("\\pi"), "expected \\pi in: {out}");
+    }
+
+    #[test]
+    fn sqrt_and_sum() {
+        let sq = latex("sqrt {x+1}");
+        assert!(sq.contains("\\sqrt"), "expected \\sqrt in: {sq}");
+        let sm = latex("sum _{i=1} ^{n} i");
+        assert!(sm.contains("\\sum"), "expected \\sum in: {sm}");
+    }
+}
