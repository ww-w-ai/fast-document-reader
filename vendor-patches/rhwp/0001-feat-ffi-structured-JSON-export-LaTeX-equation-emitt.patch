+    ordered: bool,
+    marker: Option<String>,
+}
+
+#[derive(Serialize)]
+struct Span {
+    text: String,
+    bold: bool,
+    italic: bool,
+    /// none|single|double|dotted|dashed|wavy (v1: none|single 만 구분).
+    underline: &'static str,
+    strike: bool,
+    #[serde(rename = "super")]
+    superscript: bool,
+    sub: bool,
+    /// "RRGGBB" 또는 null.
+    color: Option<String>,
+    /// base_size (HWPUNIT).
+    size: i32,
+    font: String,
+    link: Option<String>,
+    bookmark: Option<String>,
+}
+
+#[derive(Serialize)]
+struct TableBlock {
+    cols: i32,
+    #[serde(rename = "colWidths")]
+    col_widths: Vec<i32>,
+    #[serde(rename = "borderFillId")]
+    border_fill_id: i32,
+    rows: Vec<Vec<CellDto>>,
+}
+
+#[derive(Serialize)]
+struct CellDto {
+    #[serde(rename = "colSpan")]
+    col_span: i32,
+    #[serde(rename = "rowSpan")]
+    row_span: i32,
+    #[serde(rename = "vAlign")]
+    v_align: &'static str,
+    #[serde(rename = "borderFillId")]
