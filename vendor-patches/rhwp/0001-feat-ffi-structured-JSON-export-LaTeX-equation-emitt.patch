+
+/// ColorRef(0x00BBGGRR) → "RRGGBB".
+fn color_hex(c: u32) -> String {
+    let r = c & 0xFF;
+    let g = (c >> 8) & 0xFF;
+    let b = (c >> 16) & 0xFF;
+    format!("{:02X}{:02X}{:02X}", r, g, b)
+}
+
+/// 하이퍼링크 URL 을 정규화한다. hancom command 형식 = `URL;flag;...` 이고
+/// URL 안의 특수문자(`: ; # \`)는 `\` 로 이스케이프되어 있다. 첫 번째 **비-이스케이프**
+/// `;` 까지를 URL 로 보고, 이스케이프를 풀어 깨끗한 URL 을 만든다.
+fn hyperlink_url(command: &str) -> String {
+    let mut url = String::new();
+    let mut escaped = false;
+    for ch in command.chars() {
+        if escaped {
+            url.push(ch);
+            escaped = false;
+            continue;
+        }
+        match ch {
+            '\\' => escaped = true,
+            ';' => break,
+            _ => url.push(ch),
+        }
+    }
+    url.trim().to_string()
+}
+
+/// 문단 하나의 spans 를 char_shapes 경계로 분할해 구축한다.
+///
+/// 텍스트 런 외에 세 종류의 인라인 마커를 문자 순서대로 끼워 넣는다:
+/// - 하이퍼링크: `FieldRange` 가 `Field(Hyperlink)` 를 가리키면 그 문자 범위의
+///   런에 `span.link` 를 채운다.
+/// - 책갈피: `Control::Bookmark` 위치에 폭 0 앵커 span(`span.bookmark`)을 넣는다.
+/// - 각주/미주: `Control::Footnote`/`Endnote` 위치(참조 마커)에 번호 텍스트 +
+///   `superscript=true` span 을 넣는다. 본문은 구역 뒤에 별도 블록으로 붙는다.
+fn build_spans(doc_info: &DocInfo, para: &Paragraph) -> Vec<Span> {
+    let chars: Vec<char> = para.text.chars().collect();
+
+    // 하이퍼링크 문자 범위: (start_char_idx, end_char_idx, url).
+    let mut link_ranges: Vec<(usize, usize, String)> = Vec::new();
+    for fr in &para.field_ranges {
+        if let Some(Control::Field(f)) = para.controls.get(fr.control_idx) {
+            if f.field_type == FieldType::Hyperlink {
+                link_ranges.push((
+                    fr.start_char_idx,
+                    fr.end_char_idx,
+                    hyperlink_url(&f.command),
+                ));
+            }
+        }
+    }
+
+    // 책갈피/각주/미주 마커: (문자 위치, Span). 위치는 컨트롤의 텍스트 흐름 인덱스.
+    let ctrl_positions = para.control_text_positions();
+    let mut markers: Vec<(usize, Span)> = Vec::new();
+    for (ci, ctrl) in para.controls.iter().enumerate() {
+        let pos = ctrl_positions.get(ci).copied().unwrap_or(chars.len());
+        match ctrl {
+            Control::Bookmark(bm) => {
+                markers.push((pos, anchor_span(Some(bm.name.clone()))));
+            }
+            Control::Footnote(fnote) => {
+                markers.push((pos, note_marker_span(fnote.number)));
+            }
+            Control::Endnote(en) => {
+                markers.push((pos, note_marker_span(en.number)));
+            }
+            _ => {}
+        }
+    }
+
+    // 텍스트 런: (문자 시작 인덱스, Span). 제어 문자(0x00~0x1F)는 표시에서 제외.
+    let mut ordered: Vec<(usize, u8, Span)> = Vec::new();
+    if !chars.is_empty() {
+        let mut cur_id: Option<u32> = None;
+        let mut cur_text = String::new();
+        let mut cur_start = 0usize;
+        for (i, &ch) in chars.iter().enumerate() {
+            let id = para.char_shape_id_at(i).unwrap_or(0);
+            if cur_id != Some(id) {
+                if let Some(pid) = cur_id {
+                    if !cur_text.is_empty() {
+                        let link = link_at(&link_ranges, cur_start);
+                        ordered.push((
+                            cur_start,
+                            1,
+                            build_span(doc_info, pid, std::mem::take(&mut cur_text), link),
+                        ));
+                    }
+                }
+                cur_id = Some(id);
+                cur_text.clear();
+                cur_start = i;
+            }
+            if (ch as u32) >= 0x20 {
+                cur_text.push(ch);
+            }
+        }
+        if let Some(pid) = cur_id {
+            if !cur_text.is_empty() {
+                let link = link_at(&link_ranges, cur_start);
+                ordered.push((cur_start, 1, build_span(doc_info, pid, cur_text, link)));
+            }
+        }
+    }
+
+    // 마커는 sub-order 0 → 동일 위치의 런보다 앞에 온다(참조 앞 앵커 등).
+    for (pos, span) in markers {
+        ordered.push((pos, 0, span));
+    }
+    ordered.sort_by_key(|(pos, ord, _)| (*pos, *ord));
+    ordered.into_iter().map(|(_, _, span)| span).collect()
+}
+
+/// 링크 범위 목록에서 주어진 런 시작 위치를 포함하는 URL 을 찾는다.
+fn link_at(ranges: &[(usize, usize, String)], run_start: usize) -> Option<String> {
+    ranges
+        .iter()
+        .find(|(s, e, _)| run_start >= *s && run_start < *e)
+        .map(|(_, _, url)| url.clone())
+}
+
+/// 폭 0 앵커 span(책갈피/빈 마커). 표시 텍스트 없음.
+fn anchor_span(bookmark: Option<String>) -> Span {
+    Span {
+        text: String::new(),
+        bold: false,
+        italic: false,
+        underline: "none",
+        strike: false,
+        superscript: false,
+        sub: false,
+        color: None,
+        size: 0,
+        font: String::new(),
+        link: None,
+        bookmark,
+    }
+}
+
+/// 각주/미주 참조 마커 span (위첨자 번호).
+fn note_marker_span(number: u16) -> Span {
+    let mut span = anchor_span(None);
+    span.text = number.to_string();
+    span.superscript = true;
+    span
+}
+
+fn build_span(doc_info: &DocInfo, char_shape_id: u32, text: String, link: Option<String>) -> Span {
+    let cs = doc_info.char_shapes.get(char_shape_id as usize);
+    match cs {
+        Some(cs) => {
+            // KO(0) 를 주 폰트로, 비면 Latin(1) 폴백.
+            let mut font = lookup_font_name(doc_info, 0, cs.font_ids[0]);
+            if font.is_empty() {
+                font = lookup_font_name(doc_info, 1, cs.font_ids[1]);
+            }
+            let underline = if cs.underline_type == UnderlineType::None {
+                "none"
+            } else {
+                "single"
+            };
+            Span {
+                text,
+                bold: cs.bold,
+                italic: cs.italic,
+                underline,
+                strike: cs.strikethrough,
+                superscript: cs.superscript,
+                sub: cs.subscript,
+                color: Some(color_hex(cs.text_color)),
+                size: cs.base_size,
+                font,
+                link,
+                bookmark: None,
+            }
+        }
+        None => Span {
+            text,
+            bold: false,
+            italic: false,
+            underline: "none",
+            strike: false,
+            superscript: false,
+            sub: false,
+            color: None,
+            size: 0,
+            font: String::new(),
+            link,
+            bookmark: None,
+        },
+    }
+}
+
+fn build_para_block(doc: &Document, para: &Paragraph) -> ParaBlock {
+    let doc_info = &doc.doc_info;
+    let ps = doc_info.para_shapes.get(para.para_shape_id as usize);
+    // 스타일 이름 — 호스트가 "개요/제목 스타일" 을 제목으로 승격할 수 있게 그대로 넘긴다.
+    // head_type 만으로는 실무 문서 대부분의 제목을 놓친다(스타일로만 제목을 만든 문서가 흔함).
+    let style = doc_info.styles.get(para.style_id as usize);
+    let style_name = style
+        .map(|s| s.english_name.trim().to_string())
+        .filter(|s| !s.is_empty());
+    let style_local_name = style
+        .map(|s| s.local_name.trim().to_string())
+        .filter(|s| !s.is_empty());
+
+    let (heading, list) = match ps.map(|p| (p.head_type, p.para_level)) {
+        Some((HeadType::Outline, level)) => (Some(level as i32 + 1), None),
+        Some((HeadType::Number, level)) => (
+            None,
+            Some(ListInfo {
+                level: level as i32,
+                ordered: true,
+                marker: None,
+            }),
+        ),
+        Some((HeadType::Bullet, level)) => (
+            None,
+            Some(ListInfo {
+                level: level as i32,
+                ordered: false,
+                marker: None,
+            }),
+        ),
+        _ => (None, None),
+    };
+
+    let (align, indent_start, indent_end, indent_first, space_before, space_after, line_height) =
+        match ps {
+            Some(ps) => (
+                alignment_str(ps.alignment),
+                ps.margin_left,
+                ps.margin_right,
+                ps.indent,
+                ps.spacing_before,
+                ps.spacing_after,
+                LineHeight {
+                    kind: line_spacing_kind(ps.line_spacing_type),
+                    value: ps.line_spacing,
+                },
+            ),
+            None => (
+                "left",
+                0,
+                0,
+                0,
+                0,
+                0,
+                LineHeight {
+                    kind: "percent",
+                    value: 0,
+                },
+            ),
+        };
+
+    ParaBlock {
+        heading,
+        style_name,
+        style_local_name,
+        spans: build_spans(doc_info, para),
+        align,
+        indent_start,
+        indent_end,
+        indent_first,
+        space_before,
+        space_after,
+        line_height,
+        list,
+    }
+}
+
+fn build_table_block(doc: &Document, table: &Table) -> Block {
+    let col_widths: Vec<i32> = table.get_column_widths().iter().map(|w| *w as i32).collect();
+    let mut rows: Vec<Vec<CellDto>> = Vec::new();
+    for r in 0..table.row_count {
+        // 앵커 셀만: table.cells 는 앵커 셀(행 우선)만 담는다.
+        let mut row_cells: Vec<&Cell> = table.cells.iter().filter(|c| c.row == r).collect();
+        row_cells.sort_by_key(|c| c.col);
+        let cells: Vec<CellDto> = row_cells
+            .into_iter()
+            .map(|cell| CellDto {
+                col_span: cell.col_span as i32,
+                row_span: cell.row_span as i32,
+                v_align: vertical_align_str(cell.vertical_align),
+                border_fill_id: cell.border_fill_id as i32,
+                blocks: build_blocks(doc, &cell.paragraphs),
+            })
+            .collect();
+        rows.push(cells);
+    }
+    Block::Table(TableBlock {
+        cols: table.col_count as i32,
+        col_widths,
+        border_fill_id: table.border_fill_id as i32,
+        rows,
+    })
+}
+
+fn build_image_block(doc: &Document, pic: &crate::model::image::Picture) -> Block {
+    let bin_data_id = pic.image_attr.bin_data_id;
+    Block::Image(ImageBlock {
+        bin_data_id: bin_data_id as i32,
+        w: pic.common.width as i32,
+        h: pic.common.height as i32,
+        mime: image_mime(doc, bin_data_id),
+        align: horz_align_str(pic.common.horz_align),
+        width_criterion: size_criterion_str(pic.common.width_criterion),
+    })
+}
+
+fn horz_align_str(a: crate::model::shape::HorzAlign) -> &'static str {
+    use crate::model::shape::HorzAlign;
+    match a {
+        HorzAlign::Left => "left",
+        HorzAlign::Center => "center",
+        HorzAlign::Right => "right",
+        HorzAlign::Inside => "inside",
+        HorzAlign::Outside => "outside",
+    }
+}
+
+fn size_criterion_str(c: crate::model::shape::SizeCriterion) -> &'static str {
+    use crate::model::shape::SizeCriterion;
+    match c {
+        SizeCriterion::Absolute => "absolute",
+        SizeCriterion::Paper => "paper",
+        SizeCriterion::Page => "page",
+        SizeCriterion::Column => "column",
+        SizeCriterion::Para => "para",
+    }
+}
+
+/// 수식 컨트롤을 `Block::Equation` 으로 변환한다. 스크립트를 tokenize→parse→to_latex
+/// 로 LaTeX 화하고, 파싱이 빈 결과이면 `Unsupported` 로 정직하게 폴백한다.
+fn build_equation_block(e: &crate::model::control::Equation) -> Block {
+    let w = e.common.width as i32;
+    let h = e.common.height as i32;
+    let script = e.script.trim();
+    if !script.is_empty() {
+        let ast = EqParser::new(tokenize(script)).parse();
+        let latex = to_latex(&ast);
+        if !latex.trim().is_empty() {
+            return Block::Equation(EquationBlock {
+                latex,
+                script: e.script.clone(),
+                w,
+                h,
+            });
+        }
+    }
+    Block::Unsupported(UnsupportedBlock {
+        label: "equation".to_string(),
+        w,
+        h,
+    })
+}
+
+/// bin_data_content(1-based) 에서 MIME 감지. 없으면 빈 문자열.
+fn image_mime(doc: &Document, bin_data_id: u16) -> String {
+    if bin_data_id == 0 {
+        return String::new();
+    }
+    match doc.bin_data_content.get((bin_data_id - 1) as usize) {
+        Some(bdc) => {
+            crate::document_core::helpers::detect_clipboard_image_mime(&bdc.data.load()).to_string()
+        }
+        None => String::new(),
+    }
+}
+
+/// 컨트롤에서 표/그림/미지원 블록을 추출해 문단 spans 뒤에 붙인다 (v1: anchor 위치 무시, append).
+fn append_control_blocks(doc: &Document, para: &Paragraph, out: &mut Vec<Block>) {
+    for ctrl in &para.controls {
+        match ctrl {
+            Control::Table(t) => out.push(build_table_block(doc, t)),
+            Control::Picture(p) => out.push(build_image_block(doc, p)),
+            Control::Equation(e) => out.push(build_equation_block(e)),
+            Control::Shape(_) => out.push(Block::Unsupported(UnsupportedBlock {
+                label: "shape".to_string(),
+                w: 0,
+                h: 0,
+            })),
+            _ => {}
+        }
+    }
+}
+
+/// 문단 목록을 블록 배열로 변환한다 (셀 재귀에도 사용).
+fn build_blocks(doc: &Document, paragraphs: &[Paragraph]) -> Vec<Block> {
+    let mut out = Vec::new();
+    for para in paragraphs {
+        out.push(Block::Para(build_para_block(doc, para)));
+        append_control_blocks(doc, para, &mut out);
+    }
+    out
+}
+
+/// 문단 목록(및 표 셀 안)에서 각주/미주 컨트롤을 문서 순서대로 수집한다.
+fn collect_notes<'a>(paragraphs: &'a [Paragraph], out: &mut Vec<&'a Control>) {
+    for para in paragraphs {
+        for ctrl in &para.controls {
+            match ctrl {
+                Control::Footnote(_) | Control::Endnote(_) => out.push(ctrl),
+                Control::Table(t) => {
+                    for cell in &t.cells {
+                        collect_notes(&cell.paragraphs, out);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+/// 각주/미주 본문을 블록으로 변환하고, 첫 문단에 번호 접두 span 을 붙여
+/// 리더가 노트를 구분할 수 있게 한다.
+fn build_note_blocks(doc: &Document, note: &Control) -> Vec<Block> {
+    let (paragraphs, number, is_endnote) = match note {
+        Control::Footnote(f) => (&f.paragraphs, f.number, false),
+        Control::Endnote(e) => (&e.paragraphs, e.number, true),
+        _ => return Vec::new(),
+    };
+    let mut blocks = build_blocks(doc, paragraphs);
+
+    // 번호 접두 span (예: "1) ") 을 첫 Para 블록 앞에 삽입.
+    let mut prefix = note_marker_span(number);
+    prefix.text = format!("{}) ", number);
+    prefix.superscript = false;
+    if let Some(Block::Para(pb)) = blocks.iter_mut().find(|b| matches!(b, Block::Para(_))) {
+        pb.spans.insert(0, prefix);
+    } else {
+        // 문단이 없으면(빈 노트) 번호만 담은 최소 문단을 만든다.
+        blocks.insert(0, Block::Para(minimal_note_para(prefix)));
+    }
+    let _ = is_endnote;
+    blocks
+}
+
+/// 번호 span 하나만 담은 최소 문단 블록(빈 노트 폴백용).
+fn minimal_note_para(span: Span) -> ParaBlock {
+    ParaBlock {
+        heading: None,
+        style_name: None,
+        style_local_name: None,
+        spans: vec![span],
+        align: "left",
+        indent_start: 0,
+        indent_end: 0,
+        indent_first: 0,
+        space_before: 0,
+        space_after: 0,
+        line_height: LineHeight {
+            kind: "percent",
+            value: 0,
+        },
+        list: None,
+    }
+}
+
+impl DocumentCore {
+    /// 문서를 페이지 분할 없는 연속 흐름의 구조화 JSON 으로 내보낸다.
+    ///
+    /// 파서/렌더 무변경의 읽기 전용 질의. Swift 뷰어 브리지가 소비한다.
+    pub fn export_document_json(&self) -> Result<String, HwpError> {
+        let mut blocks = Vec::new();
+        for section in &self.document.sections {
+            blocks.extend(build_blocks(&self.document, &section.paragraphs));
+            // 각주/미주 본문을 구역 본문 뒤에 붙인다 (참조 마커는 본문 내 super span).
+            let mut notes = Vec::new();
+            collect_notes(&section.paragraphs, &mut notes);
+            for note in notes {
+                blocks.extend(build_note_blocks(&self.document, note));
+            }
+        }
+        let dto = DocumentJson {
+            v: 1,
+            default_font_size_pt: default_body_font_size_pt(&self.document),
+            page_content_width: page_content_width_pt(&self.document),
+            blocks,
+        };
+        serde_json::to_string(&dto).map_err(|error| {
+            HwpError::RenderError(format!("문서 구조화 JSON 직렬화에 실패했습니다: {error}"))
+        })
+    }
+}
