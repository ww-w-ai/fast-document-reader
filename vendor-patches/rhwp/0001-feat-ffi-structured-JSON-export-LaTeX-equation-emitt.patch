+    h: i32,
+    mime: String,
+    /// 개체의 가로 정렬(left/center/right/inside/outside) — HWP 개체가 스스로 들고 있는 값.
+    align: &'static str,
+    /// 너비 기준: absolute(절대 HWPUNIT) | paper | page | column | para. absolute 외에는
+    /// `w` 가 만분율(1/10000)이므로 호스트가 해당 기준 폭에 곱해야 한다.
+    #[serde(rename = "widthCriterion")]
