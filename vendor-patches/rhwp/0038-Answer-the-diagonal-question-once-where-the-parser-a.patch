+/// 셀 대각선의 방향. `BorderFill::cell_diagonal` 이 판정한다.
+///
+/// HWP 는 대각선을 두 곳에 나눠 적는다 — **선 종류**는 `DiagonalLine::diagonal_type`(표25, 네
+/// 변과 같은 코드 공간)에, **방향**은 `BorderFill::attr` 의 비트에(표24: 2-4 가 슬래시, 5-7 이
+/// 백슬래시). 그래서 어느 한쪽만으로는 판정할 수 없다.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CellDiagonal {
+    /// 왼쪽 아래 → 오른쪽 위 (`/`)
+    Slash,
+    /// 왼쪽 위 → 오른쪽 아래 (`\`)
+    Backslash,
+    /// 둘 다 (`X`)
+    Both,
+}
+
+impl CellDiagonal {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Slash => "slash",
+            Self::Backslash => "backslash",
+            Self::Both => "both",
+        }
+    }
+}
+
+impl BorderFill {
+    /// 이 테두리/배경이 선언하는 셀 **대각선**의 방향. `None` 이면 대각선이 아니다.
+    ///
+    /// 세 조건을 모두 만족해야 대각선이다:
+    ///
+    /// 1. **중심선이 아니다.** 같은 비트 자리를 중심선(셀 한가운데의 가로/세로줄)도 쓰므로,
+    ///    비트 13 이 켜진 것은 대각선이 아니라 중심선이다.
+    /// 2. `diagonal_type != 0` — 선 종류가 "없음" 이 아니다.
+    /// 3. **방향 니블이 설정돼 있다** — 종류만 있고 방향이 없으면 그릴 수 없다.
+    ///
+    /// 굵기는 보지 않는다. 굵기 0 은 "가장 가는 선" 이지 "선 없음" 이 아니다.
+    ///
+    /// 3 번이 이 판정의 전부다. `diagonal_type != 0` 만으로 세면 340 개 실문서에서 6,619 건이
+    /// 나오지만 그 대부분은 방향 비트가 없어 그려지지 않는다. 세 조건을 다 걸면 **69 건 / 문서
+    /// 36 개**이고, 참조 문서(행정업무운영편람)에는 하나뿐이다 — 대각선은 흔한 서식이 아니라
+    /// 드문 장식이다.
+    pub fn cell_diagonal(&self) -> Option<CellDiagonal> {
+        let center_line = if self.center_line != CenterLine::None {
+            self.center_line
+        } else {
+            CenterLine::from_hwp_attr(self.attr)
+        };
+        if center_line != CenterLine::None {
+            return None;
+        }
+        if self.diagonal.diagonal_type == 0 {
+            return None;
+        }
+        let slash = (self.attr >> 2) & 0x07 != 0;
+        let backslash = (self.attr >> 5) & 0x07 != 0;
+        match (slash, backslash) {
+            (true, true) => Some(CellDiagonal::Both),
+            (true, false) => Some(CellDiagonal::Slash),
+            (false, true) => Some(CellDiagonal::Backslash),
+            (false, false) => None,
+        }
+    }
+}
+
