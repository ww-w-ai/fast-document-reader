From 3825afc25f81262e71e2ca4649731c7f3bf0538f Mon Sep 17 00:00:00 2001
From: FastDocReader <taekim@ww-w.ai>
Date: Tue, 18 Aug 2026 03:08:07 +0900
Subject: [PATCH 29/35] Say whether a table repeats its heading, and where it
 may break

headerRows already told a host WHICH rows are the heading, which is a
different question from whether the author asked for them to be
reprinted overleaf, and the export never carried the answer to either
"may this table be split at all". A host that paginates for itself has
to decide both, and without these it applies one policy to every table.
---
 src/document_core/queries/document_json.rs | 24 +++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/document_core/queries/document_json.rs b/src/document_core/queries/document_json.rs
index 1b2dde71..c9de4963 100644
--- a/src/document_core/queries/document_json.rs
+++ b/src/document_core/queries/document_json.rs
@@ -22,7 +22,7 @@ use crate::model::style::{
     Alignment, BorderLine, BorderLineType, FillType, HeadType, LineSpacingType, UnderlineType,
     BORDER_WIDTHS,
 };
-use crate::model::table::{Cell, Table, VerticalAlign};
+use crate::model::table::{Cell, Table, TablePageBreak, VerticalAlign};
 use crate::renderer::equation::latex::to_latex;
 use crate::renderer::equation::parser::EqParser;
 use crate::renderer::equation::tokenizer::tokenize;
@@ -744,6 +744,26 @@ struct TableBlock {
     /// 이 신호가 없으면 여러 쪽에 걸친 표의 둘째 쪽부터 열 이름 없는 데이터만 남는다.
     #[serde(rename = "headerRows", skip_serializing_if = "is_zero_i32")]
     header_rows: i32,
+    /// 저자가 켠 **제목 줄 자동 반복** 스위치(`Table::repeat_header`). `headerRows` 와 다른 것이다 —
+    /// 그쪽은 "어느 행이 제목인가"(header 셀에서 유도)이고, 이쪽은 "쪽이 넘어갈 때 그 행을 다시
+    /// 찍으라"는 지시다. 제목 행이 있어도 이 스위치가 꺼져 있을 수 있고, 그 경우 둘째 쪽에 제목을
+    /// 다시 찍는 것은 문서가 시키지 않은 일이 된다.
+    #[serde(rename = "repeatHeader", skip_serializing_if = "std::ops::Not::not")]
+    repeat_header: bool,
+    /// 이 표를 쪽 경계에서 나눠도 되는가 — `none` 나누지 않음 / `cell` 셀 단위(행 내부까지) /
+    /// `row` 행 경계에서만. 호스트가 스스로 쪽을 나눈다면 이것이 문서의 대답이고, 이 신호가 없으면
+    /// 호스트는 모든 표에 같은 정책을 적용하게 된다.
+    #[serde(rename = "pageBreak")]
+    page_break: &'static str,
+}
+
+/// `TablePageBreak` 를 호스트 어휘로. 알 수 없는 값은 없다(열거형이 셋뿐).
+fn table_page_break_str(v: TablePageBreak) -> &'static str {
+    match v {
+        TablePageBreak::None => "none",
+        TablePageBreak::CellBreak => "cell",
+        TablePageBreak::RowBreak => "row",
+    }
 }
 
 fn is_zero_i32(v: &i32) -> bool {
@@ -1372,6 +1392,8 @@ fn build_table_block(doc: &Document, table: &Table) -> Block {
         border_fill_id: table.border_fill_id as i32,
         rows,
         header_rows: table.leading_header_rows().len() as i32,
+        repeat_header: table.repeat_header,
+        page_break: table_page_break_str(table.page_break),
     })
 }
 
