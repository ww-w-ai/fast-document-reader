From 04f33667281a6d3c2c8a8ee2862e3b5562f1a6b8 Mon Sep 17 00:00:00 2001
From: taekim <taekim@day34.com>
Date: Tue, 18 Aug 2026 20:37:00 +0900
Subject: [PATCH 40/46] Send a footnote out on its own, so a reader can put it
 where it belongs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A note's body was appended to the flow after the section that cited it, and
its reference marker was a bare superscript number — so a host had no way to
tell a note from stray body text, and no way to tell which marker pointed at
which note. Both are now said out loud: the marker carries the number and the
kind, and footnote bodies leave the flow for a document-level array shaped
like the running heads already are.

Endnotes deliberately keep arriving exactly as before. Measured over the 637
samples: 1,832 endnotes across 33 documents are already in the right place —
the end of their section — against 333 footnotes across 22 documents that are
not. Moving both to fix one would have broken the larger, correct half.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 examples/scan_footnotes.rs                 | 164 +++++++++++++++++++++
 src/document_core/queries/document_json.rs |  63 +++++++-
 2 files changed, 220 insertions(+), 7 deletions(-)
 create mode 100644 examples/scan_footnotes.rs

diff --git a/examples/scan_footnotes.rs b/examples/scan_footnotes.rs
new file mode 100644
index 00000000..58ee8685
--- /dev/null
+++ b/examples/scan_footnotes.rs
@@ -0,0 +1,164 @@
+// S14 — what a real corpus actually declares about footnotes.
+//
+// The sprint reserves a band at the foot of the page a note is CITED on. Three numbers decide
+// whether that is worth building, and one of them can cancel half of it:
+//
+//   1. how many documents cite a note at all;
+//   2. how tall a note is (paragraph counts — the band's own height);
+//   3. how many declare `print_inline_after_text`, which says "print the note straight after the
+//      body text" rather than at the foot of the sheet. A corpus that mostly says that does not
+//      want a band.
+//
+// PRIVACY: counts only. No document text, no filename, no path is ever printed — the corpus is the
+// owner's real material and this file is deliberately incapable of emitting any of it.
+
+use rhwp::model::control::Control;
+use rhwp::model::footnote::{FootnoteNumbering, FootnotePlacement};
+use rhwp::model::paragraph::Paragraph;
+use rhwp::model::table::Table;
+use rhwp::DocumentCore;
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+#[derive(Default)]
+struct Counts {
+    files_read: usize,
+    files_failed: usize,
+    docs_with_footnote: usize,
+    docs_with_endnote: usize,
+    footnotes: usize,
+    endnotes: usize,
+    notes_in_cells: usize,
+    /// note paragraph count → how many notes had it
+    note_paras: BTreeMap<usize, usize>,
+    fn_paras: BTreeMap<usize, usize>,
+    /// section-level shape declarations
+    placement: BTreeMap<&'static str, usize>,
+    numbering: BTreeMap<&'static str, usize>,
+    inline_after_text: usize,
+    shapes: usize,
+    sep_line_type: BTreeMap<u8, usize>,
+    docs_with_inline_after_text: usize,
+    footnote_samples: Vec<(u64, String, usize)>,
+}
+
+fn walk_paragraphs(paras: &[Paragraph], c: &mut Counts, doc_fn: &mut usize, doc_en: &mut usize,
+                   in_cell: bool) {
+    for p in paras {
+        for ctrl in &p.controls {
+            match ctrl {
+                Control::Footnote(f) => {
+                    c.footnotes += 1;
+                    *doc_fn += 1;
+                    if in_cell { c.notes_in_cells += 1; }
+                    *c.fn_paras.entry(f.paragraphs.len()).or_default() += 1;
+                }
+                Control::Endnote(e) => {
+                    c.endnotes += 1;
+                    *doc_en += 1;
+                    if in_cell { c.notes_in_cells += 1; }
+                    *c.note_paras.entry(e.paragraphs.len()).or_default() += 1;
+                }
+                Control::Table(t) => walk_table(t, c, doc_fn, doc_en),
+                _ => {}
+            }
+        }
+    }
+}
+
+fn walk_table(t: &Table, c: &mut Counts, doc_fn: &mut usize, doc_en: &mut usize) {
+    for cell in &t.cells {
+        walk_paragraphs(&cell.paragraphs, c, doc_fn, doc_en, true);
+    }
+}
+
+fn collect(dir: &Path, out: &mut Vec<PathBuf>) {
+    let Ok(entries) = fs::read_dir(dir) else { return };
+    for e in entries.flatten() {
+        let path = e.path();
+        if path.is_dir() {
+            collect(&path, out);
+        } else if let Some(ext) = path.extension().and_then(|s| s.to_str()) {
+            let ext = ext.to_ascii_lowercase();
+            if ext == "hwp" || ext == "hwpx" {
+                out.push(path);
+            }
+        }
+    }
+}
+
+fn main() {
+    let root = std::env::args().nth(1).unwrap_or_else(|| "samples".to_string());
+    let mut files = Vec::new();
+    collect(Path::new(&root), &mut files);
+    files.sort();
+
+    let mut c = Counts::default();
+    for path in &files {
+        let Ok(bytes) = fs::read(path) else { c.files_failed += 1; continue };
+        let Ok(core) = DocumentCore::from_bytes(&bytes) else { c.files_failed += 1; continue };
+        c.files_read += 1;
+        let doc = core.document();
+        let (mut doc_fn, mut doc_en) = (0usize, 0usize);
+        let mut doc_inline = false;
+        for section in &doc.sections {
+            walk_paragraphs(&section.paragraphs, &mut c, &mut doc_fn, &mut doc_en, false);
+            for (shape, _kind) in [(&section.section_def.footnote_shape, "footnote"),
+                                   (&section.section_def.endnote_shape, "endnote")] {
+                c.shapes += 1;
+                let place = match shape.placement {
+                    FootnotePlacement::EachColumn => "eachColumn",
+                    FootnotePlacement::BelowText => "belowText",
+                    FootnotePlacement::RightColumn => "rightColumn",
+                };
+                let numb = match shape.numbering {
+                    FootnoteNumbering::Continue => "continue",
+                    FootnoteNumbering::RestartSection => "restartSection",
+                    FootnoteNumbering::RestartPage => "restartPage",
+                };
+                *c.placement.entry(if _kind == "footnote" { "fn/" } else { "en/" }).or_default() += 0;
+                *c.placement.entry(Box::leak(format!("{_kind}/{place}").into_boxed_str())).or_default() += 1;
+                *c.numbering.entry(Box::leak(format!("{_kind}/{numb}").into_boxed_str())).or_default() += 1;
+                *c.sep_line_type.entry(shape.separator_line_type).or_default() += 1;
+                if shape.print_inline_after_text {
+                    c.inline_after_text += 1;
+                    doc_inline = true;
+                }
+            }
+        }
+        if doc_fn > 0 {
+            c.docs_with_footnote += 1;
+            // rhwp's OWN repo samples, not private material — the path is reportable here, and it is
+            // how a sprint picks its smoke document. Still no document TEXT, ever.
+            let size = fs::metadata(path).map(|m| m.len()).unwrap_or(0);
+            c.footnote_samples.push((size, path.display().to_string(), doc_fn));
+        }
+        if doc_en > 0 { c.docs_with_endnote += 1; }
+        if doc_inline { c.docs_with_inline_after_text += 1; }
+    }
+
+    println!("files read      : {} (failed {})", c.files_read, c.files_failed);
+    println!("docs citing fn  : {}", c.docs_with_footnote);
+    println!("docs citing en  : {}", c.docs_with_endnote);
+    println!("footnotes       : {}", c.footnotes);
+    println!("endnotes        : {}", c.endnotes);
+    println!("notes in cells  : {}   (S15 territory)", c.notes_in_cells);
+    println!("shapes declared : {}", c.shapes);
+    println!("inline-after-text: {} shapes / {} docs", c.inline_after_text,
+             c.docs_with_inline_after_text);
+    println!("placement       : {:?}", c.placement);
+    println!("numbering       : {:?}", c.numbering);
+    println!("separator type  : {:?}", c.sep_line_type);
+    c.footnote_samples.sort();
+    println!("--- smallest footnote-citing samples ---");
+    for (size, path, notes) in c.footnote_samples.iter().take(5) {
+        println!("  {size:>8} bytes  {notes:>3} notes  {path}");
+    }
+    let mut fp: Vec<_> = c.fn_paras.iter().collect();
+    fp.sort();
+    println!("FOOTNOTE paragraphs : {:?}", fp);
+    let mut ep: Vec<_> = c.note_paras.iter().collect();
+    ep.sort();
+    println!("endnote paragraphs  : {:?}", ep);
+}
