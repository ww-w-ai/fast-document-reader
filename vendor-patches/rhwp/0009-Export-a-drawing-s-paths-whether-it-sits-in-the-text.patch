+/// A drawing object, FLATTENED TO PATHS. rhwp's own renderer reduces every shape kind — line,
+/// rectangle, ellipse, arc, polygon, curve, group — to move/line/curve/close commands before it
+/// draws anything (`renderer/layout/shape_layout.rs`), so exporting that same reduction gives a host
+/// one thing to draw instead of nine, and no chance to disagree with the renderer about what an
+/// `arc_type` or a `round_rate` means. Coordinates are HWPUNIT in the OBJECT's own box (0,0 = its
+/// top-left), so a host scales them by whatever size it gives the object.
+///
+/// Before this the whole family arrived as `{"t":"unsupported","label":"shape","w":0,"h":0}` — no
+/// geometry and not even a size — so a host could not draw it or reserve room for it. Measured on
+/// `2025_행정업무운영편람_최종.hwp`: 79 of them, and the arrows they draw are what a reader misses
+/// when a diagram of an approval flow arrives as four labels and no lines.
+#[derive(Serialize)]
+struct ShapeBlock {
+    /// The object's own box (HWPUNIT), from `CommonObjAttr` — the same units `image`'s `w`/`h` use.
+    w: i32,
+    h: i32,
+    /// The object's own horizontal alignment, exactly as `image` carries it.
+    align: &'static str,
+    /// TRUE when the document places this object "as a character" (`treat_as_char`) — i.e. in the
+    /// text flow, where a host can draw it inline without moving anything. FALSE means the object is
+    /// ANCHORED and positioned by coordinates, over or beside the text; drawing that one inline
+    /// would push the page apart. A host with no floating-object layer must tell the two apart, and
+    /// only the parser knows which is which. Measured on `2025_행정업무운영편람_최종.hwp`: several of
+    /// its 78 shapes are the size of the whole page (555×752pt), so inlining them all cost 29 pages.
+    #[serde(rename = "asChar")]
+    as_char: bool,
+    paths: Vec<ShapePath>,
+}
+
+#[derive(Serialize)]
+struct ShapePath {
+    /// Path commands: `["M",x,y]`, `["L",x,y]`, `["C",x1,y1,x2,y2,x,y]`, `["Z"]`.
+    d: Vec<Vec<serde_json::Value>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    stroke: Option<ShapeStrokeDto>,
+    /// Solid fill (`"RRGGBB"`), or absent for no fill / a pattern / gradient / image fill — the same
+    /// honesty the border-fill table's `bg` applies.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    fill: Option<String>,
+    /// Arrowheads, from the border line's own attribute bits (10–15 start, 16–21 end).
+    #[serde(rename = "arrowStart", skip_serializing_if = "std::ops::Not::not")]
+    arrow_start: bool,
+    #[serde(rename = "arrowEnd", skip_serializing_if = "std::ops::Not::not")]
+    arrow_end: bool,
+}
+
+#[derive(Serialize)]
+struct ShapeStrokeDto {
+    color: String,
+    #[serde(rename = "widthPt")]
+    width_pt: f64,
+    /// Same four-value vocabulary the border-fill edges use (`solid`/`dash`/`dot`/`double`), taken
+    /// from the line-type bits 0–5 with rhwp's own mapping (`layout/utils.rs`).
+    #[serde(rename = "type")]
+    kind: &'static str,
+}
+
 #[derive(Serialize)]
 struct UnsupportedBlock {
     label: String,
@@ -906,16 +988,201 @@ fn append_control_blocks(doc: &Document, para: &Paragraph, out: &mut Vec<Block>)
