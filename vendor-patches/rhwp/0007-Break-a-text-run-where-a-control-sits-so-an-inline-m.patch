         for (i, &ch) in chars.iter().enumerate() {
             let id = para.char_shape_id_at(i).unwrap_or(0);
-            if cur_id != Some(id) {
+            if cur_id != Some(id) || (i > cur_start && split_at.contains(&i)) {
                 if let Some(pid) = cur_id {
                     if !cur_text.is_empty() {
                         let link = link_at(&link_ranges, cur_start);
