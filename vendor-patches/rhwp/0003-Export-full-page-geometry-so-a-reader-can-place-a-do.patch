+/// 문단 목록(및 표 셀 안)에서 머리말/꼬리말 컨트롤을 문서 순서대로 수집한다.
+///
+/// `SectionDef.master_pages`(바탕쪽)는 여기서 다루지 않는다 — 그건 구역이 통째로 대체하는
+/// 페이지 템플릿이고, 이 함수가 걷는 `Control::Header`/`Control::Footer`는 문단에 꽂힌
+/// 인라인 컨트롤이라 서로 다른 메커니즘이다(하나가 다른 하나의 폴백/특수 케이스가 아님).
+/// 바탕쪽을 이 배열에 억지로 합치면 두 메커니즘 중 무엇이 실제로 이 필드를 채웠는지 호스트가
+/// 구분할 수 없게 되므로, 의도적으로 범위 밖에 둔다(v1: `Control::Header`/`Footer`만).
+fn collect_headers_footers<'a>(
+    paragraphs: &'a [Paragraph],
+    headers: &mut Vec<&'a Control>,
+    footers: &mut Vec<&'a Control>,
+) {
+    for para in paragraphs {
+        for ctrl in &para.controls {
+            match ctrl {
+                Control::Header(_) => headers.push(ctrl),
+                Control::Footer(_) => footers.push(ctrl),
+                Control::Table(t) => {
+                    for cell in &t.cells {
+                        collect_headers_footers(&cell.paragraphs, headers, footers);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+/// `HeaderFooterApply` → JSON 문자열.
+fn header_footer_apply_str(a: HeaderFooterApply) -> &'static str {
+    match a {
+        HeaderFooterApply::Both => "both",
+        HeaderFooterApply::Even => "even",
+        HeaderFooterApply::Odd => "odd",
+    }
+}
+
+/// 수집된 머리말/꼬리말 컨트롤 참조를 `HeaderFooterEntry`로 변환한다 — 본문과 SAME
+/// `build_blocks`를 재사용하므로 호스트가 배울 블록 어휘가 늘지 않는다.
+fn build_header_footer_entries(doc: &Document, ctrls: &[&Control]) -> Vec<HeaderFooterEntry> {
+    ctrls
+        .iter()
+        .map(|ctrl| match ctrl {
+            Control::Header(h) => HeaderFooterEntry {
+                apply_to: header_footer_apply_str(h.apply_to),
+                blocks: build_blocks(doc, &h.paragraphs),
+            },
+            Control::Footer(f) => HeaderFooterEntry {
+                apply_to: header_footer_apply_str(f.apply_to),
+                blocks: build_blocks(doc, &f.paragraphs),
+            },
+            _ => unreachable!("collect_headers_footers only ever pushes Header/Footer controls"),
+        })
+        .collect()
+}
