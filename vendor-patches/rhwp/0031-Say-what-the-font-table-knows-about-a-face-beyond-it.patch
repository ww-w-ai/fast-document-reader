From 2fbf051c61c53002305c06fcaed2bfb668ed4dce Mon Sep 17 00:00:00 2001
From: taekim <taekim@day34.com>
Date: Tue, 18 Aug 2026 13:00:25 +0900
Subject: [PATCH 31/43] Say what the font table knows about a face beyond its
 name
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

FontFaceDto (document_json.rs's fontFaces export) gains three fields the exporter
already had reachable via the same Font/SubstFont records it uses for name/altName/
type/embedded/binDataId:

- panose (Font.type_info): the raw 10-byte PANOSE block, undecoded. None stays
  distinct from ten real zero bytes (PANOSE "Any" is a real declaration).
- defaultName (Font.default_name): a second name for the SAME face, not a substitute.
- substType (SubstFont.font_type): the nominated substitute's OWN file type,
  independent of the parent font's own `type` — HWPX only, HWP5 has no substFont.

Measured over the 340 real HWP5/HWPX files in samples/: 321 carry panose, 322
defaultName, 50 substType.

Found while exporting it: only HWP5's PANOSE bytes are the file's own. HWPX's
<hh:typeInfo> supplies byte 0 (familyType) from its own XML attribute, but byte 1
(serif style) is filled by synthesize_serif_type from the font NAME whenever the
element is merely present — HWPX has no attribute for that byte at all. The same
manuscript exported both ways shows it: 2025 행정업무운영 편람(최종).hwp carries
panose byte1=11, its .hwpx sibling byte1=0, for what is presumably the same
declared font. Not a reason to drop the field, but a reason any later "does PANOSE
agree with the morpheme rule" measurement must read an HWPX agreement as one guess
matching another, not independent corroboration.

Kept as a permanent regression: export_s2_font_table_fields.
---
 src/document_core/queries/document_json.rs | 67 ++++++++++++++++++++++
 1 file changed, 67 insertions(+)

diff --git a/src/document_core/queries/document_json.rs b/src/document_core/queries/document_json.rs
index 756e954d..f207a2d6 100644
--- a/src/document_core/queries/document_json.rs
+++ b/src/document_core/queries/document_json.rs
@@ -219,6 +219,27 @@ struct FontFaceDto {
     embedded: bool,
     #[serde(rename = "binDataId", skip_serializing_if = "Option::is_none")]
     bin_data_id: Option<u16>,
+    /// 같은 글꼴의 또 다른 이름(HWP5 FACE_NAME "기본 글꼴 이름"). `altName` 과 달리 대체가
+    /// 아니라 **같은 글꼴**을 가리키는 두 번째 표기다. HWP5 는 파일이 적은 그대로이고, HWPX 는
+    /// rhwp 자신의 고정 대응표(`hwp5_default_font_name`, `parser/hwpx/header.rs`)로 만든 값이라
+    /// 문서가 말한 사실이 아니다 — 두 근원이 이름은 같아도 신뢰도는 다르다.
+    #[serde(rename = "defaultName", skip_serializing_if = "Option::is_none")]
+    default_name: Option<String>,
+    /// 글꼴 유형 정보 원본 10바이트(HWP5 FACE_NAME type info, PANOSE 형식) 그대로 — 0번 바이트가
+    /// 계열(본문/필기/장식/기호), 1번이 세리프 유무. HWP5 는 파일 바이트를 그대로 옮긴 값이고,
+    /// HWPX 는 0번 바이트만 `<hh:typeInfo familyType>` 속성을 옮긴 것이며 **1번은 rhwp 자신이
+    /// 글꼴 이름 형태소로 추정해 채운 값**이다(`synthesize_serif_type`, `parser/hwpx/header.rs`) —
+    /// XML 에 그 속성 자체가 없다. `None` = 이 레코드 자체가 없음. `Some([0;10])` = 문서(혹은
+    /// rhwp)가 10바이트를 다 0으로 적음(PANOSE "Any") — 실제 값이라 없음과 같지 않다. 해석은
+    /// 여기서 하지 않는다.
+    #[serde(rename = "panose", skip_serializing_if = "Option::is_none")]
+    panose: Option<[u8; 10]>,
+    /// HWPX `<hh:substFont>` 가 지정한 대체 글꼴 자신의 유형(0 알 수 없음 / 1 TTF / 2 HFT) — 위
+    /// `type` 은 이 글꼴 자신의 유형이고 이것은 대체 글꼴의 유형이라 서로 독립적이다(TTF 글꼴이
+    /// HFT 대체를 가질 수 있음). `substFont` 자체가 없으면 생략. HWP5 에는 이 개념이 없어 항상
+    /// 생략된다.
+    #[serde(rename = "substType", skip_serializing_if = "Option::is_none")]
+    subst_type: Option<u8>,
 }
 
 fn build_font_faces(doc_info: &DocInfo) -> Vec<Vec<FontFaceDto>> {
@@ -238,6 +259,9 @@ fn build_font_faces(doc_info: &DocInfo) -> Vec<Vec<FontFaceDto>> {
                     font_type: f.alt_type,
                     embedded: f.is_embedded,
                     bin_data_id: f.resolved_bin_data_id,
+                    default_name: f.default_name.clone().filter(|s| !s.trim().is_empty()),
+                    panose: f.type_info,
+                    subst_type: f.subst_font.as_ref().map(|s| s.font_type),
                 })
                 .collect()
         })
@@ -2446,6 +2470,49 @@ mod tests {
         );
     }
 
+    /// s2 산출물: `Font.type_info`(panose) / `Font.default_name` / `SubstFont.font_type` 가 실
+    /// 샘플에서 값으로 실린다는 증거. HWP5 는 세 값 모두(단 `substFont` 는 개념 자체가 없어 항상
+    /// 없음) 파일 바이트 그대로이고, HWPX 는 panose 의 0번 바이트(familyType)만 XML 속성을 옮긴
+    /// 값이며 1번(세리프 유무)은 rhwp 자신의 `synthesize_serif_type` 추정치다 — 같은 원고의
+    /// HWP5/HWPX 두 판에서 실제로 갈리는 값(11 대 0)으로 그 차이를 직접 보여준다.
+    #[test]
+    fn export_s2_font_table_fields() {
+        // HWP5: 파일이 직접 적은 panose 10바이트 + 기본 글꼴 이름.
+        let j5 = export("samples/143E433F503322BD33.hwp");
+        assert!(
+            j5.contains("\"panose\":[2,11,6"),
+            "expected HWP5's own PANOSE bytes, byte1=11 (seriffed)"
+        );
+        assert!(
+            j5.contains("\"defaultName\":\"GulimChe\""),
+            "expected HWP5's own default name"
+        );
+        // HWP5 에는 substFont 개념이 없다 — 0 이 아니라 키 자체가 생략돼야 한다.
+        assert!(
+            !j5.contains("\"substType\""),
+            "HWP5 has no substFont concept — the key must be absent, not a default 0"
+        );
+
+        // 같은 원고의 HWP5/HWPX 두 판: 각 판의 첫 panose 항목을 나란히 대조하면, HWPX 의 세리프
+        // 바이트(1번)가 파일이 아니라 rhwp 자신의 이름-형태소 추정치라는 사실이 실측으로 드러난다.
+        let j5b = export("samples/2025 행정업무운영 편람(최종).hwp");
+        let jx = export("samples/2025 행정업무운영 편람(최종).hwpx");
+        assert!(
+            j5b.contains("\"panose\":[2,11,"),
+            "HWP5 edition should carry the file's own serif byte"
+        );
+        assert!(
+            jx.contains("\"panose\":[2,0,"),
+            "HWPX edition's serif byte is rhwp's own guess and can legitimately differ from HWP5's"
+        );
+
+        // HWPX 전용: substFont 자신의 유형은 부모 글꼴의 type 과 독립적으로 실린다.
+        assert!(
+            jx.contains("\"substType\":1"),
+            "expected the HWPX substFont's own TTF type, independent of the parent font's type"
+        );
+    }
+
     /// build_spans 가 Control::Bookmark 를 span.bookmark 앵커로 내보내는지 — 코퍼스에
     /// Control::Bookmark 를 담은 샘플이 없으므로 구성된 문단으로 그 분기가 REACHED 임을 증명.
     #[test]
