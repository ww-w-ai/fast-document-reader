<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FastDoc.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- S8-D2 (D2-b): FluentTheme's own dictionary has no "search highlight" colour at all (no
         yellow/orange family exists in it), so the find-in-document highlight — a colour scheme
         every browser already trained users on (yellow for every match, orange for the current
         one) — is defined HERE, per theme variant, rather than as a hardcoded literal inside
         FlowDocumentView.cs. The dark-variant values are dimmer than the light ones on purpose: a
         full-saturation #FFEB3B/#FF9800 reads as glare against FluentTheme's near-black dark
         background, the same reason this app's "auto" text colour is theme-resolved instead of a
         fixed Colors.Black (see FlowDocumentView.UpdateThemeBrushes). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="FindMatchHighlightColor">#FFEB3B</Color>
                    <Color x:Key="FindCurrentMatchHighlightColor">#FF9800</Color>
                    <!-- S8-B5: the exact value Sources/FastDocReader/Render/RenderTheme.swift's
                         Palette.link already ships (NSColor(rgb: 0x2E7AB8)) — a link reads the
                         same blue on macOS and this host. -->
                    <Color x:Key="LinkColor">#2E7AB8</Color>
                    <!-- S8-B4 ②: TocPanel/CommentsPanel/FindBar/EmptyStateText hardcoded hex in
                         MainWindow.axaml, moved here so both panels pick up dark mode instead of
                         staying pale grey against a dark FluentTheme window. Brushes (not bare
                         Color) because every consumer is a XAML Background/BorderBrush/Foreground
                         binding, unlike FindMatchHighlightColor above which App-code reads as a
                         raw Color for a DrawingContext fill. -->
                    <SolidColorBrush x:Key="PanelBackgroundColor" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="PanelBorderColor" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="FindBarBackgroundColor" Color="#FFF8E1" />
                    <SolidColorBrush x:Key="FindBarBorderColor" Color="#E0C060" />
                    <SolidColorBrush x:Key="EmptyStateForegroundColor" Color="#999999" />
                    <!-- S8-B3: one colour per `wire::CodeRole` (code_highlighter::Palette's seven
                         fields), read by FlowDocumentBuilder.ResolveCodeRoleColor — hex values
                         chosen to sit near macOS's own systemPink/systemTeal/systemRed/
                         systemOrange/secondaryLabel/systemGreen light-variant colours, so a
                         reader who has seen the macOS build recognises the same roles here. -->
                    <Color x:Key="CodeRoleKeywordColor">#FF2D55</Color>
                    <Color x:Key="CodeRoleTypeColor">#30B0C7</Color>
                    <Color x:Key="CodeRoleStringColor">#FF3B30</Color>
                    <Color x:Key="CodeRoleNumberColor">#FF9500</Color>
                    <Color x:Key="CodeRoleCommentColor">#6E6E73</Color>
                    <Color x:Key="CodeRoleAddedColor">#34C759</Color>
                    <Color x:Key="CodeRoleRemovedColor">#FF3B30</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="FindMatchHighlightColor">#C9A227</Color>
                    <Color x:Key="FindCurrentMatchHighlightColor">#CC7A00</Color>
                    <!-- S8-B5: the exact value RenderTheme.swift's Palette.link ships for dark
                         (NSColor(rgb: 0x6CB0F5)). -->
                    <Color x:Key="LinkColor">#6CB0F5</Color>
                    <!-- Dark-variant counterparts of the S8-B4 ② panel brushes above. -->
                    <SolidColorBrush x:Key="PanelBackgroundColor" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="PanelBorderColor" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="FindBarBackgroundColor" Color="#3A331A" />
                    <SolidColorBrush x:Key="FindBarBorderColor" Color="#8A6D2A" />
                    <SolidColorBrush x:Key="EmptyStateForegroundColor" Color="#777777" />
                    <!-- Dark-variant counterparts, at macOS's own dark system-colour brightness
                         (dimmer would read as glare-suppressed but wrong; these match). -->
                    <Color x:Key="CodeRoleKeywordColor">#FF375F</Color>
                    <Color x:Key="CodeRoleTypeColor">#40C8E0</Color>
                    <Color x:Key="CodeRoleStringColor">#FF453A</Color>
                    <Color x:Key="CodeRoleNumberColor">#FF9F0A</Color>
                    <Color x:Key="CodeRoleCommentColor">#98989D</Color>
                    <Color x:Key="CodeRoleAddedColor">#30D158</Color>
                    <Color x:Key="CodeRoleRemovedColor">#FF453A</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>